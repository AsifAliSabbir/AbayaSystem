@page "/orders/new"
@attribute [Authorize(Roles = "Admin,Salesman")]
@using AbayaSystem.Core
@using AbayaSystem.Infrastructure
@using CurrieTechnologies.Razor.SweetAlert2
@using Microsoft.AspNetCore.Components.Authorization

@inject IOrderService OrderService
@inject NavigationManager Navigation
@inject SweetAlertService Swal
@inject AuthenticationStateProvider AuthStateProvider

<div class="container-fluid max-w-1200 py-3">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1a1a1a;">✨ Multi-Item Order Intake</h3>
            <p class="text-muted small mb-0">Record Order details and add multiple items per order</p>
        </div>
        <a href="/orders" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> View All Orders
        </a>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="text-muted mt-2">Loading catalogs and configuration...</p>
        </div>
    }
    else
    {
        <!-- SECTION 1: MASTER ORDER DETAILS (Disabled once items are added) -->
        <div class="card border-0 shadow-sm rounded-3 mb-4 @(orderModel.Items.Count > 0 ? "border-start border-4 border-warning" : "")">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold m-0 text-dark">
                    <i class="bi bi-receipt me-2 text-warning"></i>1. Master Order Information
                    @if (orderModel.Items.Count > 0)
                    {
                        <span class="badge bg-warning text-dark ms-2">Locked (@orderModel.Items.Count items added)</span>
                    }
                </h6>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input bg-danger border-danger" type="checkbox" id="urgentSwitch"
                           @bind="orderModel.IsUrgent" disabled="@IsMasterLocked">
                    <label class="form-check-label fw-bold text-danger ms-1" for="urgentSwitch">🚨 Urgent Order</label>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <!-- Branch Selector Dropdown -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-muted">Showroom Branch</label>
                        <select @ref="branchSelectRef" class="form-select shadow-sm" @bind="orderModel.BranchId" disabled="@(isSalesman || IsMasterLocked)">
                            <option value="0">-- Select Branch --</option>
                            @foreach (var branch in branches.Where(b => !b.IsWorkshop))
                            {
                                <option value="@branch.BranchId">@branch.BranchName</option>
                            }
                        </select>
                    </div>

                    <!-- Receipt / Ticket Number -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-muted">Order No</label>
                        <input @ref="manualOrderIdRef" type="text" class="form-control fw-bold text-uppercase shadow-sm" placeholder=""
                               @bind="orderModel.ManualOrderId" disabled="@IsMasterLocked" />
                    </div>

                    <!-- Customer Name -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-muted">Customer Name *</label>
                        <input @ref="customerNameRef" type="text" class="form-control shadow-sm" placeholder="Client Name / Phone"
                               @bind="orderModel.CustomerName" disabled="@IsMasterLocked" />
                    </div>

                    <!-- Order Date -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-muted">Order Date *</label>
                        <input @ref="orderDateRef" type="date" class="form-control shadow-sm" @bind="orderModel.OrderDate" disabled="@IsMasterLocked" />
                    </div>

                    <!-- Delivery Date (Defaults to +12 Days) -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small text-muted">Estimated Delivery Date * (Default +12 Days)</label>
                        <input @ref="deliveryDateRef" type="date" class="form-control shadow-sm" @bind="orderModel.EstimatedDeliveryDate" disabled="@IsMasterLocked" />
                    </div>

                    <!-- Financial Summary -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small text-muted">Total Amount (AED)</label>
                        <input @ref="totalAmountRef" type="number" step="0.01" class="form-control fw-bold fs-6" @bind="orderModel.TotalAmount" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold small text-muted">Advance Deposit Paid (AED)</label>
                        <input @ref="depositPaidRef" type="number" step="0.01" class="form-control text-success fw-bold fs-6" @bind="orderModel.DepositPaid" />
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 2: ADD ITEM ENTRY FORM -->
        <div class="card border-0 shadow-sm rounded-3 mb-4 border-top border-4 border-primary">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold m-0 text-dark">
                    <i class="bi bi-plus-circle me-2 text-primary"></i>2. Add Order Line Item
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">

                    <!-- Category Dropdown -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-muted">Item Category *</label>
                        <select @ref="categorySelectRef" class="form-select shadow-sm fw-bold text-primary" @onchange="OnCategoryChanged" value="@currentItem.Category">
                            <option value="@ItemCategory.Abaya">👗 Abaya</option>
                            <option value="@ItemCategory.InnerDress">🥻 Inner Dress (Internal Only)</option>
                        </select>
                    </div>

                    <!-- Model Description -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small text-muted">Model / Style Description *</label>
                        <input @ref="modelDescRef" type="text" class="form-control shadow-sm" placeholder="" @bind="currentItem.ModelTextDescription" />
                    </div>

                    <!-- Tailor/Workflow Selection Dropdown -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-muted">Workflow / Assigned Tailor *</label>
                        <select @ref="workflowSelectRef" class="form-select shadow-sm fw-bold" @bind="currentItem.SelectedWorkflowKey" disabled="@(currentItem.Category == ItemCategory.InnerDress)">
                            <option value="">-- Select Workflow / Tailor --</option>
                            <option value="Internal">🏠 Internal Workshop</option>
                            @if (currentItem.Category == ItemCategory.Abaya)
                            {
                                @foreach (var w in externalWorkers)
                                {
                                    if (w.SupportedType == ExternalWorkerType.Hybrid || w.SupportedType == ExternalWorkerType.Both)
                                    {
                                        <option value="Hybrid_@w.ExternalWorkerId">🧵 Hybrid - @w.Name</option>
                                    }
                                    if (w.SupportedType == ExternalWorkerType.FullExternal || w.SupportedType == ExternalWorkerType.Both)
                                    {
                                        <option value="External_@w.ExternalWorkerId">🏬 Full External - @w.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <!-- Fabric Checkbox for External Worker -->
                    @if (currentItem.SelectedWorkflowKey.StartsWith("External_"))
                    {
                        <div class="col-12">
                            <div class="p-2 bg-warning-subtle rounded border border-warning form-check ms-3">
                                <input class="form-check-input" type="checkbox" id="extFabricCheck" @bind="currentItem.BuyFabricForExternal">
                                <label class="form-check-label fw-bold text-dark small" for="extFabricCheck">
                                    🛒 Buy fabric for this External Worker model?
                                </label>
                            </div>
                        </div>
                    }

                    <!-- Hybrid Execution Option Dropdown (Defaulted to Cut & Half Stitch) -->
                    @if (currentItem.SelectedWorkflowKey.StartsWith("Hybrid_"))
                    {
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Hybrid Cut & Stitch Path *</label>
                            <select @ref="hybridProcessSelectRef" class="form-select shadow-sm" @bind="currentItem.HybridProcess">
                                <option value="@HybridProcessType.CutAndHalfStitchFirst">Cut & Half-Stitch First in Workshop</option>
                                <option value="@HybridProcessType.RawFabricFirst">Raw Unstitched Fabric to Embroiderer First</option>
                            </select>
                        </div>
                    }

                    <!-- Fabric Supplier Shop Dropdown -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-muted">Fabric Supplier Shop *</label>
                        <select @ref="fabricShopSelectRef" class="form-select shadow-sm" @bind="currentItem.FabricShopId">
                            <option value="">-- Select Shop --</option>
                            @foreach (var shop in fabricShops)
                            {
                                <option value="@shop.FabricShopId">@shop.FabricShopName</option>
                            }
                        </select>
                    </div>

                    <!-- Fabric Type Dropdown -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-muted">Fabric Type *</label>
                        <select @ref="fabricSelectRef" class="form-select shadow-sm" @bind="currentItem.FabricId">
                            <option value="">-- Select Fabric --</option>
                            @foreach (var f in fabrics)
                            {
                                <option value="@f.FabricId">@f.FabricName</option>
                            }
                        </select>
                    </div>

                    <!-- Color Code -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small text-muted">Catalog Color Code *</label>
                        <input @ref="colorCodeRef" type="text" class="form-control shadow-sm" @bind="currentItem.ColorCode" placeholder="e.g. Black / #001" />
                    </div>

                    <!-- Sheila Selection Dropdown -->
                    @if (currentItem.Category == ItemCategory.Abaya)
                    {
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small text-muted">Sheila Size</label>
                            <select @ref="sheilaSizeSelectRef" class="form-select shadow-sm" @bind="currentItem.SelectedSheilaSize">
                                <option value="@SheilaSize.Size_28x81">Standard (28 x 81 in)</option>
                                <option value="@SheilaSize.Size_22x81">Small (22 x 81 in)</option>
                                <option value="@SheilaSize.Size_28x90">Custom XL (28 x 90 in - Needs Fabric)</option>
                            </select>
                        </div>
                    }

                    <!-- Add Item Button -->
                    <div class="col-12 text-end mt-3">
                        <button type="button" class="btn btn-primary fw-bold shadow-sm" @onclick="AddItemToList">
                            <i class="bi bi-plus-lg me-1"></i> Add Item to Order List
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 3: ADDED ITEMS TABLE LIST -->
        @if (orderModel.Items.Count > 0)
        {
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold m-0"><i class="bi bi-list-check me-2"></i>3. Order Items List (@orderModel.Items.Count)</h6>
                    <span class="badge bg-warning text-dark">Balance Due: AED @((orderModel.TotalAmount - orderModel.DepositPaid).ToString("N2"))</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>#</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Workflow / Tailor</th>
                                <th>Color</th>
                                <th>Fabric Buy?</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < orderModel.Items.Count; i++)
                            {
                                var item = orderModel.Items[i];
                                var index = i;
                                <tr>
                                    <td class="fw-bold">@(index + 1)</td>
                                    <td>
                                        <span class="badge @(item.Category == ItemCategory.Abaya ? "bg-info text-dark" : "bg-purple text-white")">
                                            @item.Category
                                        </span>
                                    </td>
                                    <td>@item.ModelTextDescription</td>
                                    <td><span class="fw-semibold">@GetWorkflowLabel(item)</span></td>
                                    <td><span class="badge bg-secondary">@item.ColorCode</span></td>
                                    <td>
                                        @if (item.SelectedWorkflowKey.StartsWith("External_"))
                                        {
                                            <span>@(item.BuyFabricForExternal ? "🛒 Yes" : "❌ No")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoveItem(index)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- FINAL SUBMIT BUTTON -->
        <button type="button" class="btn btn-warning w-100 py-3 fw-bold shadow rounded-3 text-uppercase fs-5"
                @onclick="HandleSubmit" disabled="@(isSubmitting || orderModel.Items.Count == 0)">
            @if (isSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Saving Order...</span>
            }
            else
            {
                <span><i class="bi bi-check-circle-fill me-2"></i> Save Entire Order (@orderModel.Items.Count Items)</span>
            }
        </button>
    }
</div>

@code {
    private OrderFormModel orderModel = new();
    private OrderItemFormModel currentItem = new()
    {
        ColorCode = "Black",
        HybridProcess = HybridProcessType.CutAndHalfStitchFirst
    };

    private List<Branch> branches = new();
    private List<FabricShop> fabricShops = new();
    private List<Fabric> fabrics = new();
    private List<ExternalWorker> externalWorkers = new();

    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isSalesman = false;

    // Target Element References (Inputs & Dropdowns)
    private ElementReference branchSelectRef;
    private ElementReference manualOrderIdRef;
    private ElementReference customerNameRef;
    private ElementReference orderDateRef;
    private ElementReference deliveryDateRef;
    private ElementReference totalAmountRef;
    private ElementReference depositPaidRef;

    private ElementReference categorySelectRef;
    private ElementReference modelDescRef;
    private ElementReference workflowSelectRef;
    private ElementReference hybridProcessSelectRef;
    private ElementReference fabricShopSelectRef;
    private ElementReference fabricSelectRef;
    private ElementReference colorCodeRef;
    private ElementReference sheilaSizeSelectRef;

    private bool IsMasterLocked => orderModel.Items.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            branches = await OrderService.GetBranchesAsync();
            fabricShops = await OrderService.GetFabricShopsAsync();
            fabrics = await OrderService.GetFabricsAsync();
            externalWorkers = await OrderService.GetExternalWorkersAsync();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isSalesman = user.IsInRole("Salesman") && !user.IsInRole("Admin");

            var branchClaim = user.FindFirst("BranchId")?.Value;
            if (int.TryParse(branchClaim, out var userBranchId) && userBranchId > 0)
            {
                orderModel.BranchId = userBranchId;
            }
            else
            {
                var defaultShowroom = branches.FirstOrDefault(b => !b.IsWorkshop);
                if (defaultShowroom != null) orderModel.BranchId = defaultShowroom.BranchId;
            }

            // Default estimated delivery date to 12 days after order date
            orderModel.EstimatedDeliveryDate = orderModel.OrderDate.AddDays(12);

            var workshop = branches.FirstOrDefault(b => b.IsWorkshop);
            currentItem.TargetBranchId = workshop != null ? workshop.BranchId : orderModel.BranchId;
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error Loading Data", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ItemCategory>(e.Value?.ToString(), out var category))
        {
            currentItem.Category = category;
            if (category == ItemCategory.InnerDress)
            {
                currentItem.SelectedWorkflowKey = "Internal";
                currentItem.BuyFabricForExternal = false;
            }
            else
            {
                currentItem.SelectedWorkflowKey = string.Empty;
            }
        }
    }

    /// <summary>
    /// Processes dynamic rules array. Displays 1.2s auto-dismissing alert and focuses invalid input/dropdown.
    /// </summary>
    private async Task<bool> ValidateFieldsAsync(params (bool IsInvalid, string Title, string Message, ElementReference ElementRef)[] rules)
    {
        foreach (var rule in rules)
        {
            if (rule.IsInvalid)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = rule.Title,
                    Text = rule.Message,
                    Icon = SweetAlertIcon.Warning,
                    ShowConfirmButton = false,
                    Timer = 1200,
                    TimerProgressBar = true
                });

                await rule.ElementRef.FocusAsync();
                return false; // Validation failed
            }
        }
        return true; // All checks passed
    }

    /// <summary>
    /// Validates Master Order Header fields
    /// </summary>
    private async Task<bool> ValidateMasterOrderAsync()
    {
        return await ValidateFieldsAsync(
            (orderModel.BranchId <= 0, "Validation Error", "Please select a valid showroom branch.", branchSelectRef),
            (string.IsNullOrWhiteSpace(orderModel.ManualOrderId), "Validation Error", "Please specify a manual receipt / ticket number.", manualOrderIdRef),
            (string.IsNullOrWhiteSpace(orderModel.CustomerName), "Validation Error", "Please enter customer name or contact.", customerNameRef),
            (orderModel.EstimatedDeliveryDate < orderModel.OrderDate, "Validation Error", "Estimated delivery must be on or after order date.", deliveryDateRef),
            (orderModel.TotalAmount < 0, "Validation Error", "Total amount cannot be negative.", totalAmountRef),
            (orderModel.DepositPaid < 0, "Validation Error", "Advance deposit paid cannot be negative.", depositPaidRef),
            (orderModel.DepositPaid > orderModel.TotalAmount, "Validation Error", "Deposit paid cannot exceed total amount.", depositPaidRef)
        );
    }

    /// <summary>
    /// Validates Line Item Input fields and Dropdowns.
    /// Fabric details are mandatory EXCEPT when Workflow is Full External AND BuyFabricForExternal is FALSE.
    /// </summary>
    private async Task<bool> ValidateCurrentItemAsync()
    {
        bool isFullExternalWithoutFabric = currentItem.SelectedWorkflowKey.StartsWith("External_") && !currentItem.BuyFabricForExternal;

        // Fabric supplier, fabric type, and catalog color code are required unless it's full external without buying fabric
        bool isFabricRequired = !isFullExternalWithoutFabric;

        return await ValidateFieldsAsync(
            (string.IsNullOrWhiteSpace(currentItem.ModelTextDescription), "Validation Error", "Please provide a model description.", modelDescRef),
            (string.IsNullOrWhiteSpace(currentItem.SelectedWorkflowKey), "Validation Error", "Please select a workflow / tailor dropdown option.", workflowSelectRef),
            (isFabricRequired && (currentItem.FabricShopId == null || currentItem.FabricShopId <= 0), "Validation Error", "Please select a fabric supplier shop.", fabricShopSelectRef),
            (isFabricRequired && (currentItem.FabricId == null || currentItem.FabricId <= 0), "Validation Error", "Please select a fabric type.", fabricSelectRef),
            (isFabricRequired && string.IsNullOrWhiteSpace(currentItem.ColorCode), "Validation Error", "Please enter a catalog color code.", colorCodeRef)
        );
    }

    private async Task AddItemToList()
    {
        // 1. Validate Master Ticket Details First
        if (!await ValidateMasterOrderAsync()) return;

        // 2. Validate Line Item Inputs & Dropdowns
        if (!await ValidateCurrentItemAsync()) return;

        var itemToAdd = new OrderItemFormModel
        {
            Category = currentItem.Category,
            ModelTextDescription = currentItem.ModelTextDescription?.Trim() ?? string.Empty,
            FabricShopId = currentItem.FabricShopId,
            FabricId = currentItem.FabricId,
            ColorCode = string.IsNullOrWhiteSpace(currentItem.ColorCode) ? "Black" : currentItem.ColorCode,
            SelectedWorkflowKey = currentItem.SelectedWorkflowKey,
            HybridProcess = currentItem.HybridProcess,
            BuyFabricForExternal = currentItem.BuyFabricForExternal,
            SelectedSheilaSize = currentItem.SelectedSheilaSize,
            IsReadyMadeAlteration = currentItem.IsReadyMadeAlteration,
            AlterationNotes = currentItem.AlterationNotes,
            ItemNotes = currentItem.ItemNotes,
            TargetBranchId = currentItem.TargetBranchId
        };

        orderModel.Items.Add(itemToAdd);

        var preserveTarget = itemToAdd.TargetBranchId;
        currentItem = new OrderItemFormModel
        {
            ColorCode = "Black",
            HybridProcess = HybridProcessType.CutAndHalfStitchFirst,
            TargetBranchId = preserveTarget
        };
    }

    private void RemoveItem(int index)
    {
        if (index >= 0 && index < orderModel.Items.Count)
        {
            orderModel.Items.RemoveAt(index);
        }
    }

    private string GetWorkflowLabel(OrderItemFormModel item)
    {
        if (item.SelectedWorkflowKey == "Internal") return "🏠 Internal Workshop";

        if (item.SelectedWorkflowKey.StartsWith("Hybrid_"))
        {
            var id = int.Parse(item.SelectedWorkflowKey.Replace("Hybrid_", ""));
            var worker = externalWorkers.FirstOrDefault(w => w.ExternalWorkerId == id);
            return $"🧵 Hybrid ({worker?.Name ?? "External"})";
        }

        if (item.SelectedWorkflowKey.StartsWith("External_"))
        {
            var id = int.Parse(item.SelectedWorkflowKey.Replace("External_", ""));
            var worker = externalWorkers.FirstOrDefault(w => w.ExternalWorkerId == id);
            return $"🏬 External ({worker?.Name ?? "External"})";
        }

        return "Unknown";
    }

    private async Task HandleSubmit()
    {
        if (!await ValidateMasterOrderAsync()) return;

        if (orderModel.Items.Count == 0)
        {
            await ValidateFieldsAsync((true, "Validation Error", "Add at least one item to the list before saving.", modelDescRef));
            return;
        }

        isSubmitting = true;

        try
        {
            var result = await OrderService.CreateOrderAsync(orderModel);

            if (result.IsSuccess)
            {
                await Swal.FireAsync("Order Saved!", $"Order #{orderModel.ManualOrderId.ToUpper()} recorded with {orderModel.Items.Count} items.", SweetAlertIcon.Success);

                var branchId = orderModel.BranchId;
                orderModel = new OrderFormModel
                {
                    BranchId = branchId,
                    OrderDate = DateTime.Today,
                    EstimatedDeliveryDate = DateTime.Today.AddDays(12)
                };
                currentItem = new OrderItemFormModel
                {
                    ColorCode = "Black",
                    HybridProcess = HybridProcessType.CutAndHalfStitchFirst
                };
            }
            else
            {
                await Swal.FireAsync("Save Failed", result.ErrorMessage, SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("System Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}