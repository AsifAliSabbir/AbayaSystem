@page "/"
@inject NavigationManager Navigation

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<div class="container py-5 text-center">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Syncing terminal profiles...</span>
    </div>
    <h5 class="mt-3 text-muted fw-bold">REDIRECTING TO OPERATIONAL COMPONENT...</h5>
</div>

@code {
    protected override void OnInitialized()
    {
        // 🔄 Automatic router redirection to your workspace floor screen
        Navigation.NavigateTo("/orders/new");
    }
}