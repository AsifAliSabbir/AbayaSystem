@page "/external-workers"
@attribute [Authorize(Roles = "Admin,Salesman")]
@using AbayaSystem.Core
@using AbayaSystem.Infrastructure
@using CurrieTechnologies.Razor.SweetAlert2

@inject IExternalWorkerService WorkerService
@inject SweetAlertService Swal

<div class="container-fluid max-w-1200 py-3">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1a1a1a;">🏬 External Workers</h3>
            <p class="text-muted small mb-0">Manage external tailors, embroiderers, and service partners</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="text-muted mt-2">Loading external workers list...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th style="width: 60px;">#</th>
                                <th>Worker Name *</th>
                                <th>Phone / Contact</th>
                                <th>Supported Work Type *</th>
                                <th class="text-center" style="width: 180px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (workers.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No external workers found. Use the bottom row to add one.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @for (int i = 0; i < workers.Count; i++)
                                {
                                    var worker = workers[i];
                                    var index = i + 1;

                                    if (editingWorkerId == worker.ExternalWorkerId)
                                    {
                                        <!-- INLINE EDIT ROW -->
                                        <tr class="table-warning">
                                            <td class="fw-bold">@index</td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="editingWorker.Name" placeholder="Worker Name" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="editingWorker.Phone" placeholder="Phone Number" />
                                            </td>
                                            <td>
                                                <select class="form-select form-select-sm fw-bold" @bind="editingWorker.SupportedType">
                                                    <option value="@ExternalWorkerType.Hybrid">🧵 Hybrid</option>
                                                    <option value="@ExternalWorkerType.FullExternal">🏬 Full External</option>
                                                    <option value="@ExternalWorkerType.Both">🔄 Both (Hybrid & Full)</option>
                                                </select>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-success fw-bold" @onclick="UpdateWorkerAsync">
                                                        <i class="bi bi-check-lg me-1"></i> Update
                                                    </button>
                                                    <button class="btn btn-secondary" @onclick="CancelEdit">
                                                        <i class="bi bi-x-lg me-1"></i> Cancel
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <!-- NORMAL DISPLAY ROW -->
                                        <tr>
                                            <td class="fw-bold">@index</td>
                                            <td class="fw-semibold">@worker.Name</td>
                                            <td>@(string.IsNullOrWhiteSpace(worker.Phone) ? "-" : worker.Phone)</td>
                                            <td>
                                                <span class="badge @GetBadgeClass(worker.SupportedType)">
                                                    @GetWorkerTypeLabel(worker.SupportedType)
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary" @onclick="() => StartEdit(worker)">
                                                        <i class="bi bi-pencil me-1"></i> Edit
                                                    </button>
                                                    <button class="btn btn-outline-danger" @onclick="() => ConfirmDeleteAsync(worker)">
                                                        <i class="bi bi-trash me-1"></i> Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            }

                            <!-- BOTTOM ROW: ADD NEW WORKER -->
                            <tr class="bg-light border-top border-2">
                                <td class="fw-bold text-muted">New</td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" @bind="newWorker.Name" placeholder="Enter Name *" />
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" @bind="newWorker.Phone" placeholder="Enter Phone" />
                                </td>
                                <td>
                                    <select class="form-select form-select-sm fw-bold text-primary" @bind="newWorker.SupportedType">
                                        <option value="@ExternalWorkerType.Hybrid">🧵 Hybrid</option>
                                        <option value="@ExternalWorkerType.FullExternal">🏬 Full External</option>
                                        <option value="@ExternalWorkerType.Both">🔄 Both (Hybrid & Full)</option>
                                    </select>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-primary fw-bold" @onclick="AddWorkerAsync" disabled="@isSubmitting">
                                            <i class="bi bi-plus-lg me-1"></i> Add
                                        </button>
                                        <button class="btn btn-outline-secondary" @onclick="ClearNewWorkerInput">
                                            <i class="bi bi-eraser me-1"></i> Cancel
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ExternalWorker> workers = new();
    private ExternalWorker newWorker = new() { SupportedType = ExternalWorkerType.Both };
    private ExternalWorker editingWorker = new();

    private int? editingWorkerId = null;
    private bool isLoading = true;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkersAsync();
    }

    private async Task LoadWorkersAsync()
    {
        try
        {
            isLoading = true;
            workers = await WorkerService.GetExternalWorkersAsync();
        }
        catch (Exception ex)
        {
            await ShowAutoAlertAsync("Error Loading Data", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    // --- ADD WORKER LOGIC ---
    private async Task AddWorkerAsync()
    {
        if (string.IsNullOrWhiteSpace(newWorker.Name))
        {
            await ShowAutoAlertAsync("Validation Error", "Worker name cannot be empty.", SweetAlertIcon.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            var createdWorker = await WorkerService.CreateExternalWorkerAsync(newWorker);
            workers.Add(createdWorker);
            ClearNewWorkerInput();
            await ShowAutoAlertAsync("Worker Added", "New external worker added successfully.", SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            await ShowAutoAlertAsync("Error Adding Worker", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ClearNewWorkerInput()
    {
        newWorker = new ExternalWorker
        {
            SupportedType = ExternalWorkerType.Both
        };
    }

    // --- INLINE EDIT LOGIC ---
    private void StartEdit(ExternalWorker worker)
    {
        editingWorkerId = worker.ExternalWorkerId;
        editingWorker = new ExternalWorker
        {
            ExternalWorkerId = worker.ExternalWorkerId,
            Name = worker.Name,
            Phone = worker.Phone,
            SupportedType = worker.SupportedType,
            IsActive = worker.IsActive
        };
    }

    private void CancelEdit()
    {
        editingWorkerId = null;
        editingWorker = new();
    }

    private async Task UpdateWorkerAsync()
    {
        if (string.IsNullOrWhiteSpace(editingWorker.Name))
        {
            await ShowAutoAlertAsync("Validation Error", "Worker name cannot be empty.", SweetAlertIcon.Warning);
            return;
        }

        try
        {
            await WorkerService.UpdateExternalWorkerAsync(editingWorker);

            var index = workers.FindIndex(w => w.ExternalWorkerId == editingWorker.ExternalWorkerId);
            if (index != -1)
            {
                workers[index] = new ExternalWorker
                {
                    ExternalWorkerId = editingWorker.ExternalWorkerId,
                    Name = editingWorker.Name,
                    Phone = editingWorker.Phone,
                    SupportedType = editingWorker.SupportedType,
                    IsActive = editingWorker.IsActive
                };
            }

            CancelEdit();
            await ShowAutoAlertAsync("Updated", "Worker details updated successfully.", SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            await ShowAutoAlertAsync("Update Failed", ex.Message, SweetAlertIcon.Error);
        }
    }

    // --- DELETE LOGIC ---
    private async Task ConfirmDeleteAsync(ExternalWorker worker)
    {
        var confirmResult = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Are you sure?",
            Text = $"Do you want to delete '{worker.Name}'? This action cannot be undone.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Delete",
            CancelButtonText = "Cancel",
            ConfirmButtonColor = "#dc3545"
        });

        if (confirmResult.IsConfirmed)
        {
            try
            {
                await WorkerService.DeleteExternalWorkerAsync(worker.ExternalWorkerId);
                workers.RemoveAll(w => w.ExternalWorkerId == worker.ExternalWorkerId);
                await ShowAutoAlertAsync("Deleted", "External worker removed successfully.", SweetAlertIcon.Success);
            }
            catch (Exception ex)
            {
                await ShowAutoAlertAsync("Delete Failed", ex.Message, SweetAlertIcon.Error);
            }
        }
    }

    // --- HELPER METHODS ---
    private async Task ShowAutoAlertAsync(string title, string message, SweetAlertIcon icon)
    {
        await Swal.FireAsync(new SweetAlertOptions
        {
            Title = title,
            Text = message,
            Icon = icon,
            ShowConfirmButton = false,
            Timer = 1200,
            TimerProgressBar = true
        });
    }

    private string GetWorkerTypeLabel(ExternalWorkerType type) => type switch
    {
        ExternalWorkerType.Hybrid => "🧵 Hybrid",
        ExternalWorkerType.FullExternal => "🏬 Full External",
        ExternalWorkerType.Both => "🔄 Both (Hybrid & Full)",
        _ => "Unknown"
    };

    private string GetBadgeClass(ExternalWorkerType type) => type switch
    {
        ExternalWorkerType.Hybrid => "bg-info text-dark",
        ExternalWorkerType.FullExternal => "bg-warning text-dark",
        ExternalWorkerType.Both => "bg-primary text-white",
        _ => "bg-secondary"
    };
}