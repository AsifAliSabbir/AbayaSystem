@page "/procurement"
@attribute [Authorize(Roles = "Admin,Salesman,CuttingMaster")]
@using AbayaSystem.Core
@using AbayaSystem.Infrastructure
@using CurrieTechnologies.Razor.SweetAlert2

@inject IOrderService OrderService
@inject SweetAlertService Swal

<div class="container-fluid max-w-1200 py-3">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1a1a1a;">🛍️ Fabric Procurement</h3>
            <p class="text-muted small mb-0">Track and manage pending fabric purchases for custom abayas and sheilas</p>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="LoadDataAsync" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh List
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="text-muted mt-2">Loading procurement items...</p>
        </div>
    }
    else
    {
        <!-- SECTION 1: ABAYA FABRICS TO BUY -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold m-0 text-dark">
                    <i class="bi bi-scissors me-2 text-primary"></i>1. Abaya Fabrics To Buy
                    <span class="badge bg-primary ms-2">@abayaFabrics.Count</span>
                </h6>
            </div>
            <div class="card-body p-0">
                @if (abayaFabrics.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-check-circle fs-3 text-success d-block mb-2"></i>
                        No pending fabric purchases for Abayas!
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Ticket #</th>
                                    <th>Customer</th>
                                    <th>Shop</th>
                                    <th>Fabric Type</th>
                                    <th>Color Code</th>
                                    <th>Description</th>
                                    <th>Order Date</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in abayaFabrics)
                                {
                                    <tr>
                                        <td class="fw-bold text-uppercase">#@item.OrderId</td>
                                        <td>@item.CustomerName</td>
                                        <td><span class="badge bg-info text-dark">@item.FabricShopName</span></td>
                                        <td><span class="fw-semibold">@item.FabricName</span></td>
                                        <td><span class="badge bg-dark">@item.ColorCode</span></td>
                                        <td class="small text-muted">@item.ModelDescription</td>
                                        <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-success fw-semibold shadow-sm"
                                                    @onclick="() => ConfirmMarkAsBought(item.OrderItemId, item.OrderId)">
                                                <i class="bi bi-cart-check me-1"></i> Mark Bought
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- SECTION 2: CUSTOM SHEILA FABRICS TO BUY -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold m-0 text-dark">
                    <i class="bi bi-bag-check me-2 text-warning"></i>2. Custom Sheila Fabrics To Buy (28 x 90)
                    <span class="badge bg-warning text-dark ms-2">@sheilaFabrics.Count</span>
                </h6>
            </div>
            <div class="card-body p-0">
                @if (sheilaFabrics.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-check-circle fs-3 text-success d-block mb-2"></i>
                        No custom Sheila fabric purchases required!
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Ticket #</th>
                                    <th>Customer</th>
                                    <th>Sheila Size</th>
                                    <th>Description</th>
                                    <th>Order Date</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in sheilaFabrics)
                                {
                                    <tr>
                                        <td class="fw-bold text-uppercase">#@item.OrderId</td>
                                        <td>@item.CustomerName</td>
                                        <td><span class="badge bg-warning text-dark">@item.SelectedSheilaSize</span></td>
                                        <td class="small text-muted">@item.ModelTextDescription</td>
                                        <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-success fw-semibold shadow-sm"
                                                    @onclick="() => ConfirmMarkAsBought(item.OrderItemId, item.OrderId)">
                                                <i class="bi bi-cart-check me-1"></i> Mark Bought
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<FabricProcurementItem> abayaFabrics = new();
    private List<SheilaProcurementItem> sheilaFabrics = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            abayaFabrics = await OrderService.GetPendingAbayaFabricsAsync();
            sheilaFabrics = await OrderService.GetPendingSheilaFabricsAsync();
        }
        catch (Exception ex)
        {
            await Swal.FireAsync("Error Loading Data", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmMarkAsBought(int orderItemId, string orderId)
    {
        var confirm = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirm Purchase",
            Text = $"Mark fabric for Order #{orderId} as bought and move to Cutting?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Mark as Bought",
            CancelButtonText = "Cancel"
        });

        if (confirm.IsConfirmed)
        {
            var result = await OrderService.MarkFabricAsBoughtAsync(orderItemId);

            if (result.IsSuccess)
            {
                await Swal.FireAsync("Purchased!", $"Item status updated to '{ItemStatus.AssignedToCutter}'.", SweetAlertIcon.Success);
                await LoadDataAsync();
            }
            else
            {
                await Swal.FireAsync("Update Failed", result.ErrorMessage, SweetAlertIcon.Error);
            }
        }
    }
}