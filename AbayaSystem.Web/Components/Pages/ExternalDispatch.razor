@page "/external-dispatch"
@attribute [Authorize(Roles = "Admin,Salesman")]

@using AbayaSystem.Core
@using AbayaSystem.Infrastructure
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CurrieTechnologies.Razor.SweetAlert2

@inject BoutiqueDbContext DbContext
@inject IWorkflowService WorkflowService
@inject SweetAlertService Swal

<PageTitle>External Dispatch - Abaya System</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark m-0">🚚 External Vendor Dispatch</h3>
            <p class="text-muted small m-0">Dispatch queued items to their pre-assigned external vendor.</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm">
            Pending Dispatch: <strong>@filteredItems.Count</strong>
        </span>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">External Vendor</label>
                    <select class="form-select" @bind="selectedVendorId" @bind:after="ApplyFilter">
                        <option value="0">All Vendors</option>
                        @foreach (var vendor in vendors)
                        {
                            <option value="@vendor.ExternalWorkerId">@vendor.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">Order No</label>
                    <input class="form-control" @bind="orderSearch" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="Search order number" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-secondary fw-bold" @onclick="ResetFilter">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted fw-bold">Loading dispatch queue...</p>
        </div>
    }
    else if (!filteredItems.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <i class="bi bi-check-circle-fill display-4 text-success"></i>
            <h5 class="mt-3 fw-bold">No Items Awaiting Dispatch</h5>
            <p class="text-muted mb-0">There are no external vendor items matching the selected filters.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Order No</th>
                            <th>Item</th>
                            <th>Customer</th>
                            <th>Workflow Stage</th>
                            <th>Assigned Vendor</th>
                            <th>Delivery Date</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in filteredItems)
                        {
                            <tr>
                                <td class="fw-bold">#@item.OrderId</td>
                                <td>
                                    <div class="fw-semibold">#@item.OrderItemId</div>
                                    <small class="text-muted">@item.ModelTextDescription</small>
                                </td>
                                <td>@(item.Order?.Customer?.CustomerName ?? "N/A")</td>
                                <td><span class="badge bg-warning text-dark">@GetStageLabel(item.Status)</span></td>
                                <td>
                                    <span class="fw-semibold">@(item.ExternalWorker?.Name ?? "Unassigned")</span>
                                </td>
                                <td>@(item.Order?.EstimatedDeliveryDate.ToString("dd MMM yyyy") ?? "N/A")</td>
                                <td class="text-end">
                                    @if (item.ExternalWorkerId.HasValue)
                                    {
                                        <button class="btn btn-sm btn-primary fw-bold" @onclick="() => ConfirmDispatch(item)">
                                            <i class="bi bi-truck me-1"></i> Dispatch
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Vendor not assigned</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private int selectedVendorId;
    private string orderSearch = string.Empty;
    private List<ExternalWorker> vendors = new();
    private List<OrderItem> allItems = new();
    private List<OrderItem> filteredItems = new();

    private static readonly ItemStatus[] DispatchStatuses =
    {
        ItemStatus.QueueExternalVendor,
        ItemStatus.QueueRawFabricEmb,
        ItemStatus.QueueHalfStitchEmb
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        vendors = await DbContext.ExternalWorkers
            .AsNoTracking()
            .Where(w => w.IsActive)
            .OrderBy(w => w.Name)
            .ToListAsync();

        allItems = await DbContext.OrderItems
            .Include(i => i.Order)
                .ThenInclude(o => o.Customer)
            .Include(i => i.ExternalWorker)
            .Where(i => DispatchStatuses.Contains(i.Status) && i.ExternalWorkerId.HasValue)
            .ToListAsync();

        ApplyFilter();
        isLoading = false;
    }

    private void ApplyFilter()
    {
        IEnumerable<OrderItem> query = allItems;

        if (selectedVendorId > 0)
        {
            query = query.Where(i => i.ExternalWorkerId == selectedVendorId);
        }

        if (!string.IsNullOrWhiteSpace(orderSearch))
        {
            var search = orderSearch.Trim();
            query = query.Where(i => i.OrderId.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        filteredItems = query
            .OrderByDescending(i => i.Order?.EstimatedDeliveryDate ?? DateTime.MinValue)
            .ThenBy(i => i.OrderId)
            .ThenBy(i => i.OrderItemId)
            .ToList();
    }

    private void ResetFilter()
    {
        selectedVendorId = 0;
        orderSearch = string.Empty;
        ApplyFilter();
    }

    private async Task ConfirmDispatch(OrderItem item)
    {
        var vendorName = item.ExternalWorker?.Name ?? "the assigned vendor";
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirm Dispatch",
            Text = $"Dispatch Order #{item.OrderId}, Item #{item.OrderItemId} to {vendorName}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Dispatch",
            CancelButtonText = "Cancel",
            ConfirmButtonColor = "#0d6efd"
        });

        if (!result.IsConfirmed)
        {
            return;
        }

        var targetItem = await DbContext.OrderItems
            .Include(i => i.ExternalWorker)
            .FirstOrDefaultAsync(i => i.OrderItemId == item.OrderItemId);

        if (targetItem == null || !DispatchStatuses.Contains(targetItem.Status) || !targetItem.ExternalWorkerId.HasValue)
        {
            await Swal.FireAsync("Dispatch unavailable", "The item has already changed or has no assigned vendor.", SweetAlertIcon.Warning);
            await LoadDataAsync();
            return;
        }

        var nextStatus = targetItem.Status switch
        {
            ItemStatus.QueueExternalVendor => ItemStatus.OutWithExternalVendor,
            ItemStatus.QueueRawFabricEmb => ItemStatus.OutForRawFabricEmb,
            ItemStatus.QueueHalfStitchEmb => ItemStatus.OutForHalfStitchEmb,
            _ => targetItem.Status
        };

        var dispatched = await WorkflowService.TransitionStatusAsync(
            targetItem.OrderItemId,
            nextStatus,
            notes: $"Dispatched to external vendor '{targetItem.ExternalWorker.Name}'.");

        if (dispatched)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Item Dispatched",
                Text = $"Item #{targetItem.OrderItemId} was dispatched to {targetItem.ExternalWorker.Name}.",
                Icon = SweetAlertIcon.Success,
                Timer = 1800,
                ShowConfirmButton = false
            });
        }

        await LoadDataAsync();
    }

    private static string GetStageLabel(ItemStatus status) => status switch
    {
        ItemStatus.QueueExternalVendor => "Full external vendor",
        ItemStatus.QueueRawFabricEmb => "Raw fabric embroidery",
        ItemStatus.QueueHalfStitchEmb => "Half-stitch embroidery",
        _ => status.ToString()
    };
}
