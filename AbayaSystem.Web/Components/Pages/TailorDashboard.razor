@page "/tailor-dashboard"
@attribute [Authorize(Roles = "Admin, Salesman, Tailor, CuttingMaster")]

@using AbayaSystem.Core
@using AbayaSystem.Infrastructure
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CurrieTechnologies.Razor.SweetAlert2
@using Microsoft.AspNetCore.Components.Authorization

@inject BoutiqueDbContext DbContext
@inject IWorkflowService WorkflowService
@inject SweetAlertService Swal
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@Ui["TailorDashboardTitle"] - Abaya System</PageTitle>

<div class="container-fluid p-0">

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark m-0">🧵 @Ui["TailorDashboardTitle"]</h3>
            <p class="text-muted small m-0">@Ui["TrackTailorTasks"]</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm">
                @Ui["AssignedItems"]: <strong>@filteredAssignedItemsCount</strong>
            </span>
        </div>
    </div>

    <!-- ⚡ CURRENTLY WORKING SECTION -->
    @if (activeItem != null)
    {
        <div class="card border-0 shadow-sm mb-4 bg-primary text-white overflow-hidden">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2 px-3">
                <span class="fw-bold text-warning small text-uppercase">
                    <i class="bi bi-activity me-1 spinner-grow spinner-grow-sm text-warning" role="status"></i>
                    @Ui["CurrentlyWorkingTask"]
                </span>
                <span class="badge bg-warning text-dark fw-bold">
                    @Ui.ForStatus(activeItem.Status)
                </span>
            </div>
            <div class="card-body p-4 bg-primary text-white">
                <div class="row align-items-center g-3">
                    <div class="col-lg-8">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-light text-dark fw-bold fs-6">Order #@activeItem.OrderId</span>
                            <span class="badge bg-warning text-dark fw-bold">Item #@activeItem.OrderItemId</span>
                            <span class="badge bg-info text-dark fw-bold">@Ui[activeItem.Category.ToString()]</span>
                            @if (activeItem.Order != null)
                            {
                                <span class="badge bg-secondary">@Ui[activeItem.TypeOfOrder.ToString()]</span>
                            }
                        </div>
                        <h4 class="fw-bold mb-1">@activeItem.ModelTextDescription</h4>
                        <div class="d-flex flex-wrap gap-3 small opacity-90 mt-2">
                            <span><i class="bi bi-palette me-1"></i> @Ui["Color"]: <strong>@(string.IsNullOrWhiteSpace(activeItem.ColorCode) ? Ui["NA"] : activeItem.ColorCode)</strong></span>
                            <span><i class="bi bi-layers me-1"></i> @Ui["Fabric"]: <strong>@(activeItem.Fabric?.FabricName ?? Ui["NA"])</strong></span>
                            <span><i class="bi bi-shop me-1"></i> @Ui["Shop"]: <strong>@(activeItem.FabricShop?.FabricShopName ?? Ui["NA"])</strong></span>
                            <span><i class="bi bi-person me-1"></i> @Ui["Customer"]: <strong>@(activeItem.Order?.Customer?.CustomerName ?? Ui["NA"])</strong></span>
                            <span><i class="bi bi-calendar-event me-1"></i> @Ui["DeliveryDate"]: <strong>@(activeItem.Order?.EstimatedDeliveryDate.ToString("dd MMM yyyy") ?? Ui["NA"])</strong></span>
                        </div>
                    </div>
                    <div class="col-lg-4 text-lg-end d-flex flex-column flex-sm-row gap-2 justify-content-lg-end">
                        <button class="btn btn-light text-dark fw-bold btn-sm shadow-sm"
                                @onclick="() => ShowCustomerMeasurements(activeItem.Order?.Customer)">
                            <i class="bi bi-ruler me-1"></i> @Ui["ViewMeasurements"]
                        </button>

                        @if (canControlTasks && (!isTailorUser || activeItem.StitchedByWorkerId == currentUserId))
                        {
                            <button class="btn btn-success fw-bold shadow" @onclick="CompleteCurrentTask">
                                <i class="bi bi-check-circle-fill me-1"></i> @Ui["CompleteStitching"]
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- 🔍 FILTERS PANEL -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body bg-white rounded-3 p-3">
            <div class="row g-3 align-items-end">
                <!-- Order No Filter -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark small text-uppercase mb-1">@Ui["OrderNo"]</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-hash text-muted"></i></span>
                        <input type="text"
                               class="form-control border-start-0 bg-light"
                               placeholder="@Ui["SearchOrderNo"]"
                               @bind="filterOrderId"
                               @bind:event="oninput"
                               @onkeyup="ApplyFilters" />
                    </div>
                </div>

                <!-- Order Date Filter -->
                <div class="col-md-2">
                    <label class="form-label fw-bold text-dark small text-uppercase mb-1">@Ui["OrderDate"]</label>
                    <input type="date" class="form-control bg-light" @bind="filterOrderDate" @bind:after="ApplyFilters" />
                </div>

                <!-- Delivery Date Filter -->
                <div class="col-md-2">
                    <label class="form-label fw-bold text-dark small text-uppercase mb-1">@Ui["DeliveryDate"]</label>
                    <input type="date" class="form-control bg-light" @bind="filterDeliveryDate" @bind:after="ApplyFilters" />
                </div>

                <!-- Tailor Dropdown Filter -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark small text-uppercase mb-1">@Ui["AssignedTailor"]</label>
                    <select class="form-select bg-light"
                            disabled="@isTailorUser"
                            value="@selectedTailorId"
                            @onchange="OnTailorSelectChanged">
                        <option value="0">@Ui["AllTailors"]</option>
                        @foreach (var tailor in availableTailors)
                        {
                            <option value="@tailor.WorkerId">@tailor.Name (@tailor.Username)</option>
                        }
                    </select>
                </div>

                <!-- Reset Button -->
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100 fw-bold" @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> @Ui["Reset"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 📦 GROUPED TASK LIST -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Ui["Loading"]</span>
            </div>
            <p class="mt-2 text-muted fw-bold">@Ui["LoadingTailorTasks"]</p>
        </div>
    }
    else if (groupedOrders == null || !groupedOrders.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4 bg-white">
            <div class="text-muted">
                <i class="bi bi-journal-check display-4 text-success opacity-75"></i>
                <h5 class="mt-3 text-dark fw-bold">@Ui["NoAssignedTasks"]</h5>
                <p class="mb-0 text-muted">@Ui["NoAssignedTasksDescription"]</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var group in groupedOrders)
        {
            var firstItem = group.First();
            var parentOrder = firstItem.Order;
            bool isUrgent = parentOrder?.IsUrgent ?? false;

            <div class="card border-0 shadow-sm mb-4 @(isUrgent ? "border-start border-4 border-danger" : "")">

                <!-- Order Header -->
                <div class="card-header @(isUrgent ? "bg-danger text-white" : "bg-dark text-white") d-flex justify-content-between align-items-center py-3 px-3">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <span class="fw-bold fs-6">
                            <i class="bi bi-receipt me-1"></i> @Ui["OrderNoHeader"]: #@group.Key
                        </span>

                        @if (isUrgent)
                        {
                            <span class="badge bg-warning text-dark fw-bold text-uppercase px-2 py-1">
                                🚨 @Ui["Urgent"]
                            </span>
                        }

                        <span class="small opacity-85">
                            <i class="bi bi-person me-1"></i> @Ui["Customer"]: <strong>@(parentOrder?.Customer?.CustomerName ?? Ui["NA"])</strong>
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <span class="small opacity-85">
                            <i class="bi bi-calendar-event me-1"></i> @Ui["OrderDate"]: @(parentOrder?.OrderDate.ToString("dd MMM yyyy") ?? Ui["NA"])
                        </span>
                        <span class="badge bg-light text-dark fw-bold px-3 py-2">
                            <i class="bi bi-truck me-1 text-primary"></i> @Ui["Due"]: @(parentOrder?.EstimatedDeliveryDate.ToString("dd MMM yyyy") ?? Ui["NA"])
                        </span>
                    </div>
                </div>

                <!-- Items Table -->
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th class="ps-3" style="width: 100px;">@Ui["ItemID"]</th>
                                    <th>@Ui["CategoryAndModel"]</th>
                                    <th>@Ui["FabricAndColor"]</th>
                                    <th>@Ui["Flags"]</th>
                                    <th>@Ui["Status"]</th>
                                    <th>@Ui["AssignedTailor"]</th>
                                    <th>@Ui["Measurements"]</th>
                                         @if (canControlTasks)
                                    {
                                        <th class="text-end pe-3" style="width: 160px;">@Ui["Action"]</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group)
                                {
                                    bool isWorkingOnThis = activeItem?.BranchId == item.BranchId && activeItem.OrderId == item.OrderId && activeItem.OrderItemId == item.OrderItemId;

                                    <tr class="@(isWorkingOnThis ? "table-primary" : "")">
                                        <!-- Item ID -->
                                        <td class="ps-3 fw-bold text-dark">
                                            #@item.OrderItemId
                                        </td>

                                        <!-- Model Description -->
                                        <td>
                                            <span class="badge bg-info text-dark me-1">@item.Category</span>
                                            <span class="fw-bold text-dark">@item.ModelTextDescription</span>
                                            @if (item.Category == ItemCategory.Abaya && item.SelectedSheilaSize != SheilaSize.Size_28x81)
                                            {
                                                <div class="small text-muted">@Ui["Sheila"]: @Ui[item.SelectedSheilaSize.ToString()]</div>
                                            }
                                        </td>

                                        <!-- Fabric & Color -->
                                        <td>
                                            <div class="fw-semibold text-dark">@(item.Fabric?.FabricName ?? "N/A")</div>
                                            <span class="badge bg-secondary extra-small">
                                                @Ui["Color"]: @(string.IsNullOrWhiteSpace(item.ColorCode) ? Ui["NA"] : item.ColorCode)
                                            </span>
                                        </td>

                                        <!-- Workflow Flags -->
                                        <td>
                                            @if (item.HandEmbRequired)
                                            {
                                                <span class="badge bg-primary extra-small me-1">@Ui["HandEmb"]</span>
                                            }
                                            @if (item.rawFabricEmb)
                                            {
                                                <span class="badge bg-dark extra-small me-1">@Ui["RawFabricEmb"]</span>
                                            }
                                            @if (item.Order != null)
                                            {
                                                <span class="badge bg-outline-secondary extra-small text-dark border">@Ui[item.TypeOfOrder.ToString()]</span>
                                            }
                                        </td>

                                        <!-- Status -->
                                        <td>
                                            @if (item.Status == ItemStatus.HalfStitchActive || item.Status == ItemStatus.FullStitchActive)
                                            {
                                                <span class="badge bg-warning text-dark fw-bold">
                                                    <i class="bi bi-gear-wide-connected me-1 spinner-border spinner-border-sm"></i>@Ui.ForStatus(item.Status)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@Ui.ForStatus(item.Status)</span>
                                            }
                                        </td>

                                        <!-- Assigned Tailor -->
                                        <td>
                                            <span class="small fw-bold text-dark">
                                                <i class="bi bi-person-circle me-1 text-primary"></i>
                                                @GetTailorName(item.StitchedByWorkerId)
                                            </span>
                                        </td>

                                        <!-- View Specs Button -->
                                        <td>
                                            <button class="btn btn-sm btn-outline-dark extra-small fw-bold"
                                                    @onclick="() => ShowCustomerMeasurements(item.Order?.Customer)">
                                                <i class="bi bi-ruler me-1"></i> @Ui["ViewSpecs"]
                                            </button>
                                        </td>

                                        <!-- Action Column (Hidden for Salesman & Cutting Master) -->
                                        @if (isTailorUser)
                                        {
                                            <td class="text-end pe-3">
                                                @if (isWorkingOnThis)
                                                {
                                                    <span class="badge bg-success px-3 py-2 fw-bold">
                                                        <i class="bi bi-play-circle-fill me-1"></i> @Ui["Active"]
                                                    </span>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-primary fw-bold shadow-sm px-3"
                                                             disabled="@(activeItem != null || (isTailorUser && item.StitchedByWorkerId != currentUserId))"
                                                            @onclick="() => ConfirmAndStartTask(item)">
                                                        <i class="bi bi-play-fill me-1"></i> @Ui["Start"]
                                                    </button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- 📏 CUSTOMER MEASUREMENTS MODAL -->
@if (isMeasurementModalOpen && currentCustomer != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-ruler text-warning me-2"></i>@currentCustomer.CustomerName - @Ui["CustomerMeasurementsTitle"]
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseMeasurementModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3 text-center">
                        <div class="col-6"><div class="p-2 border rounded bg-light"><small class="text-muted d-block">@Ui["AbayaFrontLength"]</small><strong>@currentCustomer.LengthAbayaFront @Ui["Inches"]</strong></div></div>
                        <div class="col-6"><div class="p-2 border rounded bg-light"><small class="text-muted d-block">@Ui["AbayaBackLength"]</small><strong>@currentCustomer.LengthAbayaBack @Ui["Inches"]</strong></div></div>
                        <div class="col-6"><div class="p-2 border rounded bg-light"><small class="text-muted d-block">@Ui["SleeveLength"]</small><strong>@currentCustomer.LengthSleeve @Ui["Inches"]</strong></div></div>
                        <div class="col-6"><div class="p-2 border rounded bg-light"><small class="text-muted d-block">@Ui["ShoulderWidth"]</small><strong>@currentCustomer.WidthShoulder @Ui["Inches"]</strong></div></div>
                        <div class="col-6"><div class="p-2 border rounded bg-light"><small class="text-muted d-block">@Ui["ArmHoleWidth"]</small><strong>@currentCustomer.WidthArmHole @Ui["Inches"]</strong></div></div>
                        <div class="col-6"><div class="p-2 border rounded bg-light"><small class="text-muted d-block">@Ui["BodyChestWidth"]</small><strong>@currentCustomer.WidthBody @Ui["Inches"]</strong></div></div>
                        <div class="col-6"><div class="p-2 border rounded bg-light"><small class="text-muted d-block">@Ui["SleeveOpeningWidth"]</small><strong>@currentCustomer.WidthSleeveOpening @Ui["Inches"]</strong></div></div>
                        <div class="col-6"><div class="p-2 border rounded bg-light"><small class="text-muted d-block">@Ui["BottomFlareWidth"]</small><strong>@currentCustomer.WidthBottom @Ui["Inches"]</strong></div></div>
                        <div class="col-12"><div class="p-2 border rounded bg-light"><small class="text-muted d-block">@Ui["ButtonConfiguration"]</small><strong>@Ui[currentCustomer.ButtonType.ToString()] (@currentCustomer.NumberOfButtons @Ui["ButtonsCount"])</strong></div></div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary fw-bold" @onclick="CloseMeasurementModal">@Ui["Close"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private int currentUserId = 0;
    private bool isTailorUser = false;
    private bool isAdminUser = false;
    private bool canControlTasks => isTailorUser || isAdminUser;
    private int filteredAssignedItemsCount = 0;

    // Filters
    private string filterOrderId = string.Empty;
    private DateTime? filterOrderDate;
    private DateTime? filterDeliveryDate;
    private int selectedTailorId = 0;

    // Data Containers
    private OrderItem? activeItem;
    private List<OrderItem> allTailorItems = new();
    private List<Worker> availableTailors = new();
    private IEnumerable<IGrouping<string, OrderItem>>? groupedOrders;

    // Modal
    private bool isMeasurementModalOpen = false;
    private Customer? currentCustomer;

    protected override async Task OnInitializedAsync()
    {
        await IdentifyUserAndRoleAsync();
        await LoadAvailableTailorsAsync();
        await LoadTailorTaskDataAsync();
    }

    private async Task IdentifyUserAndRoleAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = await CurrentUserResolver.GetWorkerIdAsync(AuthStateProvider, DbContext);
        if (userId.HasValue)
        {
            var worker = await DbContext.Workers.FirstOrDefaultAsync(w => w.WorkerId == userId.Value);
            if (worker != null)
            {
                currentUserId = worker.WorkerId;
                // Check bitwise WorkerRole flags for Tailor
                isTailorUser = (worker.AssignedRoles & (WorkerRole.Tailor | WorkerRole.CuttingMaster)) != (WorkerRole)0;
                isAdminUser = (worker.AssignedRoles & WorkerRole.Admin) == WorkerRole.Admin;

                if (isTailorUser)
                {
                    selectedTailorId = currentUserId;
                }
            }
        }
    }

    private async Task LoadAvailableTailorsAsync()
    {
        var workers = await DbContext.Workers.AsNoTracking().ToListAsync();
        availableTailors = workers
            .Where(w => (w.AssignedRoles & (WorkerRole.Tailor | WorkerRole.CuttingMaster)) != (WorkerRole)0)
            .ToList();
    }

    private async Task LoadTailorTaskDataAsync()
    {
        isLoading = true;

        var stitchingStatuses = new[]
        {
            ItemStatus.QueueHalfStitching,
            ItemStatus.HalfStitchActive,
            ItemStatus.QueueFullStitching,
            ItemStatus.FullStitchActive
        };

        allTailorItems = await DbContext.OrderItems
            .Include(i => i.Order)
                .ThenInclude(o => o.Customer)
            .Include(i => i.Fabric)
            .Include(i => i.FabricShop)
            .Where(i => stitchingStatuses.Contains(i.Status))
            .ToListAsync();

        // Identify currently active stitching task
        activeItem = allTailorItems.FirstOrDefault(i =>
            (i.Status == ItemStatus.HalfStitchActive || i.Status == ItemStatus.FullStitchActive) &&
            i.StitchedByWorkerId == (isTailorUser ? currentUserId : (selectedTailorId > 0 ? selectedTailorId : i.StitchedByWorkerId)));

        ApplyFilters();
        isLoading = false;
    }

    private void OnTailorSelectChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            selectedTailorId = id;
            ApplyFilters();
        }
    }

    private void ApplyFilters()
    {
        var query = allTailorItems.AsEnumerable();

        if (selectedTailorId > 0)
        {
            query = query.Where(i => i.StitchedByWorkerId == selectedTailorId);
        }

        if (!string.IsNullOrWhiteSpace(filterOrderId))
        {
            var cleanQuery = filterOrderId.Trim().ToLower();
            query = query.Where(i => i.OrderId.ToLower().Contains(cleanQuery));
        }

        if (filterOrderDate.HasValue)
        {
            query = query.Where(i => i.Order != null && i.Order.OrderDate.Date == filterOrderDate.Value.Date);
        }

        if (filterDeliveryDate.HasValue)
        {
            query = query.Where(i => i.Order != null && i.Order.EstimatedDeliveryDate.Date == filterDeliveryDate.Value.Date);
        }

        var filteredList = query.ToList();
        filteredAssignedItemsCount = filteredList.Count;

        // Group by OrderId and sort by delivery date descending
        groupedOrders = filteredList
            .GroupBy(i => i.OrderId)
            .OrderByDescending(g => g.First().Order?.IsUrgent ?? false)
            .ThenByDescending(g => g.First().Order?.EstimatedDeliveryDate ?? DateTime.MinValue);
    }

    private void ResetFilters()
    {
        filterOrderId = string.Empty;
        filterOrderDate = null;
        filterDeliveryDate = null;
        if (!isTailorUser)
        {
            selectedTailorId = 0;
        }
        ApplyFilters();
    }

    private async Task ConfirmAndStartTask(OrderItem item)
    {
        if (activeItem != null)
        {
            await Swal.FireAsync(Ui["ActiveTaskInProgress"], Ui["ActiveTaskWarning"], SweetAlertIcon.Warning);
            return;
        }

        var confirmResult = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = Ui["StartStitchingTaskQuestion"],
            Text = $"{Ui["StartTaskText"]} #{item.OrderId} - {Ui["ItemLabel"]} #{item.OrderItemId} ({item.ModelTextDescription})?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = Ui["YesStartTask"],
            CancelButtonText = Ui["Cancel"],
            ConfirmButtonColor = "#0d6efd"
        });

        if (confirmResult.IsConfirmed)
        {
            var targetItem = await DbContext.OrderItems.FirstOrDefaultAsync(i => i.BranchId == item.BranchId && i.OrderId == item.OrderId && i.OrderItemId == item.OrderItemId);
            if (targetItem != null)
            {
                ItemStatus? nextStatus = null;
                if (targetItem.Status == ItemStatus.QueueHalfStitching)
                {
                    nextStatus = ItemStatus.HalfStitchActive;
                }
                else if (targetItem.Status == ItemStatus.QueueFullStitching)
                {
                    nextStatus = ItemStatus.FullStitchActive;
                }

                if (nextStatus.HasValue)
                {
                    var workerId = isTailorUser ? currentUserId : targetItem.StitchedByWorkerId;
                    await WorkflowService.TransitionStatusAsync(
                        targetItem.OrderItemId,
                        nextStatus.Value,
                        workerId,
                        "TailorStartedStitching",
                        performedByWorkerId: currentUserId,
                        branchId: targetItem.BranchId,
                        orderId: targetItem.OrderId);
                }

                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = Ui["TaskStarted"],
                    Text = $"{Ui["ItemLabel"]} #{item.OrderItemId} {Ui["ItemNowActive"]}",
                    Icon = SweetAlertIcon.Success,
                    Timer = 1500,
                    ShowConfirmButton = false
                });

                await LoadTailorTaskDataAsync();
            }
        }
    }

    private async Task CompleteCurrentTask()
    {
        if (activeItem == null) return;

        var confirmResult = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = Ui["CompleteStitchingTaskQuestion"],
            Text = $"{Ui["CompleteTaskText"]} #{activeItem.OrderItemId}",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = Ui["YesCompleteTask"],
            CancelButtonText = Ui["Cancel"],
            ConfirmButtonColor = "#198754"
        });

        if (confirmResult.IsConfirmed)
        {
            var targetItem = await DbContext.OrderItems
                .Include(i => i.Order)
                .FirstOrDefaultAsync(i => i.BranchId == activeItem.BranchId && i.OrderId == activeItem.OrderId && i.OrderItemId == activeItem.OrderItemId);

            if (targetItem != null)
            {
                ItemStatus nextStatus;
                OrderType orderType = targetItem.TypeOfOrder;

                if (targetItem.Status == ItemStatus.HalfStitchActive)
                {
                    nextStatus = WorkflowService.DetermineNextStatusAfterHalfStitching(
                        orderType,
                        targetItem.HandEmbRequired,
                        targetItem.rawFabricEmb);
                }
                else // FullStitchActive
                {
                    nextStatus = WorkflowService.DetermineNextStatusAfterFullStitching();
                }

                await WorkflowService.TransitionStatusAsync(
                    targetItem.OrderItemId,
                    nextStatus,
                    currentUserId,
                    "TailorCompletedStitching",
                    performedByWorkerId: currentUserId,
                    branchId: targetItem.BranchId,
                    orderId: targetItem.OrderId);

                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = Ui["TaskCompleted"],
                    Text = $"{Ui["ItemLabel"]} #{targetItem.OrderItemId} {Ui["ItemMovedToNextStage"]}",
                    Icon = SweetAlertIcon.Success,
                    Timer = 2000,
                    ShowConfirmButton = false
                });

                await LoadTailorTaskDataAsync();
            }
        }
    }

    private void ShowCustomerMeasurements(Customer? customer)
    {
        if (customer != null)
        {
            currentCustomer = customer;
            isMeasurementModalOpen = true;
        }
    }

    private void CloseMeasurementModal()
    {
        isMeasurementModalOpen = false;
        currentCustomer = null;
    }

    private string GetTailorName(int? workerId)
    {
        if (!workerId.HasValue)
        {
            return Ui["Unassigned"];
        }

        var tailor = availableTailors.FirstOrDefault(worker => worker.WorkerId == workerId.Value);
        return tailor?.Name ?? tailor?.Username ?? Ui["Unassigned"];
    }
}

