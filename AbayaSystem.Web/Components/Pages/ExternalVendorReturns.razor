@page "/external-vendor-returns"
@attribute [Authorize(Roles = "Admin,Salesman")]

@using AbayaSystem.Core
@using AbayaSystem.Infrastructure
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CurrieTechnologies.Razor.SweetAlert2

@inject BoutiqueDbContext DbContext
@inject IWorkflowService WorkflowService
@inject SweetAlertService Swal

<PageTitle>External Vendor Returns - Abaya System</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark m-0">↩️ External Vendor Returns</h3>
            <p class="text-muted small m-0">Record items returned from external vendors and move them to the next workflow stage.</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2">Awaiting Return: <strong>@filteredJobs.Count</strong></span>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">Vendor</label>
                    <select class="form-select" @bind="selectedVendorId" @bind:after="ApplyFilter">
                        <option value="0">All Vendors</option>
                        @foreach (var vendor in vendors)
                        {
                            <option value="@vendor.ExternalWorkerId">@vendor.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted text-uppercase">Order No</label>
                    <input class="form-control" @bind="orderSearch" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="Search order number" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-secondary fw-bold" @onclick="ResetFilter">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!filteredJobs.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <i class="bi bi-check-circle-fill display-4 text-success"></i>
            <h5 class="mt-3 fw-bold">No Vendor Returns Pending</h5>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Order / Item</th>
                            <th>Customer</th>
                            <th>Vendor</th>
                            <th>Work Type</th>
                            <th>Dispatched</th>
                            <th>Expected Return</th>
                            <th>Order Delivery</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in filteredJobs)
                        {
                            var overdue = job.ExpectedReturnDate.HasValue && job.ExpectedReturnDate.Value.Date < DateTime.UtcNow.Date;
                            <tr class="@(overdue ? "table-danger" : "")">
                                <td class="fw-bold">#@job.OrderItem?.OrderId / #@job.OrderItemId<br /><small class="text-muted">@job.OrderItem?.ModelTextDescription</small></td>
                                <td>@(job.OrderItem?.Order?.Customer?.CustomerName ?? "N/A")</td>
                                <td>@job.ExternalWorker?.Name</td>
                                <td>@GetStageLabel(job.Stage)</td>
                                <td>@job.DispatchedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td>@(job.ExpectedReturnDate?.ToString("dd MMM yyyy") ?? "Not set")</td>
                                <td>@(job.OrderItem?.Order?.EstimatedDeliveryDate.ToString("dd MMM yyyy") ?? "N/A")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-success fw-bold" @onclick="() => ConfirmReturn(job)">
                                        <i class="bi bi-box-arrow-in-left me-1"></i> Mark Returned
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private int selectedVendorId;
    private string orderSearch = string.Empty;
    private List<ExternalWorker> vendors = new();
    private List<ExternalVendorJob> allJobs = new();
    private List<ExternalVendorJob> filteredJobs = new();

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        vendors = await DbContext.ExternalWorkers.AsNoTracking().OrderBy(w => w.Name).ToListAsync();
        allJobs = await DbContext.ExternalVendorJobs
            .AsNoTracking()
            .Include(j => j.ExternalWorker)
            .Include(j => j.OrderItem)
                .ThenInclude(i => i.Order)
                    .ThenInclude(o => o.Customer)
            .Where(j => j.Status == ExternalVendorJobStatus.Dispatched)
            .OrderBy(j => j.ExpectedReturnDate)
            .ThenBy(j => j.DispatchedAt)
            .ToListAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        IEnumerable<ExternalVendorJob> query = allJobs;
        if (selectedVendorId > 0) query = query.Where(j => j.ExternalWorkerId == selectedVendorId);
        if (!string.IsNullOrWhiteSpace(orderSearch)) query = query.Where(j => j.OrderItem?.OrderId.Contains(orderSearch.Trim(), StringComparison.OrdinalIgnoreCase) == true);
        filteredJobs = query.ToList();
    }

    private void ResetFilter()
    {
        selectedVendorId = 0;
        orderSearch = string.Empty;
        ApplyFilter();
    }

    private async Task ConfirmReturn(ExternalVendorJob job)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirm Vendor Return",
            Text = $"Record Item #{job.OrderItemId} as returned from {job.ExternalWorker?.Name}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Mark Returned",
            CancelButtonText = "Cancel",
            ConfirmButtonColor = "#198754"
        });

        if (!result.IsConfirmed) return;

        var returned = await WorkflowService.MarkExternalVendorReturnedAsync(
            job.ExternalVendorJobId,
            "Item returned from external vendor.");

        if (returned)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Return Recorded",
                Text = $"Item #{job.OrderItemId} was moved to its next workflow stage.",
                Icon = SweetAlertIcon.Success,
                Timer = 1800,
                ShowConfirmButton = false
            });
        }

        await LoadDataAsync();
    }

    private static string GetStageLabel(ExternalVendorJobStage stage) => stage switch
    {
        ExternalVendorJobStage.RawFabricEmbroidery => "Raw fabric embroidery",
        ExternalVendorJobStage.HalfStitchEmbroidery => "Half-stitch embroidery",
        ExternalVendorJobStage.FullExternalProduction => "Full external production",
        _ => stage.ToString()
    };
}
