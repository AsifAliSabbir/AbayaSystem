@page "/fabric-types"
@attribute [Authorize(Roles = "Admin,Salesman")]
@using AbayaSystem.Core
@using AbayaSystem.Infrastructure
@using CurrieTechnologies.Razor.SweetAlert2

@inject IFabricManagementService FabricService
@inject SweetAlertService Swal

<div class="container-fluid max-w-1200 py-3">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1a1a1a;">🧵 Fabric Types</h3>
            <p class="text-muted small mb-0">Manage catalog fabric materials (e.g., Nida, Crepe, Silk)</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="text-muted mt-2">Loading fabric types list...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th style="width: 60px;">#</th>
                                <th>Fabric Type Name *</th>
                                <th class="text-center" style="width: 180px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (fabrics.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        No fabric types found. Use the bottom row to add one.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @for (int i = 0; i < fabrics.Count; i++)
                                {
                                    var fabric = fabrics[i];
                                    var index = i + 1;

                                    if (editingFabricId == fabric.FabricId)
                                    {
                                        <!-- INLINE EDIT ROW -->
                                        <tr class="table-warning">
                                            <td class="fw-bold">@index</td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="editingFabric.FabricName" placeholder="Fabric Name" />
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-success fw-bold" @onclick="UpdateFabricAsync">
                                                        <i class="bi bi-check-lg me-1"></i> Update
                                                    </button>
                                                    <button class="btn btn-secondary" @onclick="CancelEdit">
                                                        <i class="bi bi-x-lg me-1"></i> Cancel
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <!-- NORMAL DISPLAY ROW -->
                                        <tr>
                                            <td class="fw-bold">@index</td>
                                            <td class="fw-semibold">@fabric.FabricName</td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary" @onclick="() => StartEdit(fabric)">
                                                        <i class="bi bi-pencil me-1"></i> Edit
                                                    </button>
                                                    <button class="btn btn-outline-danger" @onclick="() => ConfirmDeleteAsync(fabric)">
                                                        <i class="bi bi-trash me-1"></i> Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            }

                            <!-- BOTTOM ROW: ADD NEW FABRIC -->
                            <tr class="bg-light border-top border-2">
                                <td class="fw-bold text-muted">New</td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" @bind="newFabric.FabricName" placeholder="Enter Fabric Name *" />
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-primary fw-bold" @onclick="AddFabricAsync" disabled="@isSubmitting">
                                            <i class="bi bi-plus-lg me-1"></i> Add
                                        </button>
                                        <button class="btn btn-outline-secondary" @onclick="ClearNewFabricInput">
                                            <i class="bi bi-eraser me-1"></i> Cancel
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Fabric> fabrics = new();
    private Fabric newFabric = new();
    private Fabric editingFabric = new();

    private int? editingFabricId = null;
    private bool isLoading = true;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadFabricsAsync();
    }

    private async Task LoadFabricsAsync()
    {
        try
        {
            isLoading = true;
            fabrics = await FabricService.GetFabricsAsync();
        }
        catch (Exception ex)
        {
            await ShowAutoAlertAsync("Error Loading Data", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    // --- ADD FABRIC LOGIC ---
    private async Task AddFabricAsync()
    {
        if (string.IsNullOrWhiteSpace(newFabric.FabricName))
        {
            await ShowAutoAlertAsync("Validation Error", "Fabric name cannot be empty.", SweetAlertIcon.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            var createdFabric = await FabricService.CreateFabricAsync(newFabric);
            fabrics.Add(createdFabric);
            ClearNewFabricInput();
            await ShowAutoAlertAsync("Fabric Added", "New fabric type added successfully.", SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            await ShowAutoAlertAsync("Error Adding Fabric", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ClearNewFabricInput()
    {
        newFabric = new Fabric();
    }

    // --- INLINE EDIT LOGIC ---
    private void StartEdit(Fabric fabric)
    {
        editingFabricId = fabric.FabricId;
        editingFabric = new Fabric
        {
            FabricId = fabric.FabricId,
            FabricName = fabric.FabricName
        };
    }

    private void CancelEdit()
    {
        editingFabricId = null;
        editingFabric = new();
    }

    private async Task UpdateFabricAsync()
    {
        if (string.IsNullOrWhiteSpace(editingFabric.FabricName))
        {
            await ShowAutoAlertAsync("Validation Error", "Fabric name cannot be empty.", SweetAlertIcon.Warning);
            return;
        }

        try
        {
            await FabricService.UpdateFabricAsync(editingFabric);

            var index = fabrics.FindIndex(f => f.FabricId == editingFabric.FabricId);
            if (index != -1)
            {
                fabrics[index] = new Fabric
                {
                    FabricId = editingFabric.FabricId,
                    FabricName = editingFabric.FabricName
                };
            }

            CancelEdit();
            await ShowAutoAlertAsync("Updated", "Fabric details updated successfully.", SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            await ShowAutoAlertAsync("Update Failed", ex.Message, SweetAlertIcon.Error);
        }
    }

    // --- DELETE LOGIC ---
    private async Task ConfirmDeleteAsync(Fabric fabric)
    {
        var confirmResult = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Are you sure?",
            Text = $"Do you want to delete '{fabric.FabricName}'? This action cannot be undone.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Delete",
            CancelButtonText = "Cancel",
            ConfirmButtonColor = "#dc3545"
        });

        if (confirmResult.IsConfirmed)
        {
            try
            {
                await FabricService.DeleteFabricAsync(fabric.FabricId);
                fabrics.RemoveAll(f => f.FabricId == fabric.FabricId);
                await ShowAutoAlertAsync("Deleted", "Fabric type removed successfully.", SweetAlertIcon.Success);
            }
            catch (Exception ex)
            {
                await ShowAutoAlertAsync("Delete Failed", ex.Message, SweetAlertIcon.Error);
            }
        }
    }

    // --- HELPER METHODS ---
    private async Task ShowAutoAlertAsync(string title, string message, SweetAlertIcon icon)
    {
        await Swal.FireAsync(new SweetAlertOptions
        {
            Title = title,
            Text = message,
            Icon = icon,
            ShowConfirmButton = false,
            Timer = 1200,
            TimerProgressBar = true
        });
    }
}