@page "/ready-items"
@attribute [Authorize(Roles = "Admin,Salesman")]

@using AbayaSystem.Core
@using AbayaSystem.Infrastructure
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CurrieTechnologies.Razor.SweetAlert2

@inject BoutiqueDbContext DbContext
@inject IWorkflowService WorkflowService
@inject SweetAlertService Swal

<PageTitle>Ready Items - Abaya System</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark m-0">📦 Ready Items</h3>
            <p class="text-muted small m-0">Receive completed items from the workshop and deliver showroom-ready items.</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm">Ready Items: <strong>@filteredItems.Count</strong></span>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted text-uppercase">Order No</label>
                    <input class="form-control" @bind="orderSearch" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="Search order number" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted text-uppercase">Order Date</label>
                    <input type="date" class="form-control" @bind="orderDate" @bind:after="ApplyFilter" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted text-uppercase">Delivery Date</label>
                    <input type="date" class="form-control" @bind="deliveryDate" @bind:after="ApplyFilter" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted text-uppercase">Location</label>
                    <select class="form-select" @bind="selectedLocation" @bind:after="ApplyFilter">
                        <option value="0">Workshop and Showroom</option>
                        <option value="1">Ready at Workshop</option>
                        <option value="2">Ready at Showroom</option>
                        <option value="3">Delivered</option>
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-outline-secondary fw-bold" @onclick="ResetFilter">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted fw-bold">Loading ready items...</p>
        </div>
    }
    else if (!filteredGroups.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <i class="bi bi-check-circle-fill display-4 text-success"></i>
            <h5 class="mt-3 fw-bold">No Ready Items Found</h5>
            <p class="text-muted mb-0">No items match the selected filters.</p>
        </div>
    }
    else
    {
        @foreach (var group in filteredGroups)
        {
            var remaining = GetRemainingCount(group.Key);
            var allReady = remaining == 0;
            var orderReadyItems = allItems.Where(i => i.OrderId == group.Key).ToList();
            var allAtShop = allReady && orderReadyItems.Count > 0 && orderReadyItems.All(i => i.Status == ItemStatus.ReadyAtShop);
            var hasWorkshopItems = orderReadyItems.Any(i => i.Status == ItemStatus.ReadyAtWorkShop);
            var parentOrder = group.First().Order;

            <div class="card border-0 shadow-sm mb-4 @(allReady ? "border-start border-4 border-success" : "")">
                <div class="card-header @(allReady ? "bg-success text-white" : "bg-dark text-white") d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="fw-bold me-3">ORDER #@group.Key</span>
                        <span class="small">@(parentOrder?.Customer?.CustomerName ?? "N/A")</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (allReady)
                        {
                            <span class="badge bg-light text-success">All items ready</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@remaining item(s) remaining</span>
                        }
                        @if (allAtShop)
                        {
                            <button class="btn btn-sm btn-light text-success fw-bold" @onclick="() => ConfirmDeliverOrder(group.Key)">
                                <i class="bi bi-box-seam me-1"></i> Deliver Whole Order
                            </button>
                        }
                        else if (hasWorkshopItems)
                        {
                            <button class="btn btn-sm btn-light text-dark fw-bold" @onclick="() => ConfirmReceiveOrder(group.Key)">
                                <i class="bi bi-shop me-1"></i> Receive Workshop Items
                            </button>
                        }
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th>Description</th>
                                <th>Location</th>
                            <th>Estimated Delivery</th>
                            <th>Actual Delivery</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in group)
                            {
                                <tr>
                                    <td class="fw-bold">#@item.OrderItemId</td>
                                    <td>@item.ModelTextDescription</td>
                                    <td>
                                        <span class="badge @(item.Status == ItemStatus.ReadyAtWorkShop ? "bg-info text-dark" : item.Status == ItemStatus.ReadyAtShop ? "bg-success" : "bg-secondary")">
                                            @(item.Status == ItemStatus.ReadyAtWorkShop ? "Workshop" : item.Status == ItemStatus.ReadyAtShop ? "Showroom" : "Delivered")
                                        </span>
                                    </td>
                                    <td>@(item.Order?.EstimatedDeliveryDate.ToString("dd MMM yyyy") ?? "N/A")</td>
                                    <td>@(item.ActualDeliveryDate?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                                    <td class="text-end">
                                        @if (item.Status == ItemStatus.ReadyAtWorkShop)
                                        {
                                            <button class="btn btn-sm btn-outline-primary fw-bold" @onclick="() => ConfirmReceiveItem(item)">
                                                <i class="bi bi-shop me-1"></i> Receive at Shop
                                            </button>
                                        }
                                        else if (item.Status == ItemStatus.ReadyAtShop)
                                        {
                                            <button class="btn btn-sm btn-success fw-bold" @onclick="() => ConfirmDeliverItem(item)">
                                                <i class="bi bi-check2-circle me-1"></i> Deliver Item
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-check2 me-1"></i> Delivered</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private string orderSearch = string.Empty;
    private DateTime? orderDate;
    private DateTime? deliveryDate;
    private int selectedLocation;
    private List<OrderItem> allItems = new();
    private List<OrderItem> filteredItems = new();
    private IEnumerable<IGrouping<string, OrderItem>> filteredGroups = Enumerable.Empty<IGrouping<string, OrderItem>>();
    private Dictionary<string, int> remainingCounts = new();

    private static readonly ItemStatus[] DisplayStatuses =
    {
        ItemStatus.ReadyAtWorkShop,
        ItemStatus.ReadyAtShop,
        ItemStatus.Delivered
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        allItems = await DbContext.OrderItems
            .Include(i => i.Order)
                .ThenInclude(o => o.Customer)
            .Where(i => DisplayStatuses.Contains(i.Status))
            .OrderBy(i => i.OrderId)
            .ThenBy(i => i.OrderItemId)
            .ToListAsync();

        var orderIds = allItems.Select(i => i.OrderId).Distinct().ToList();
        var orderItems = await DbContext.OrderItems
            .Where(i => orderIds.Contains(i.OrderId))
            .ToListAsync();

        remainingCounts = orderItems
            .GroupBy(i => i.OrderId)
            .ToDictionary(
                g => g.Key,
                    g => g.Count(i => !DisplayStatuses.Contains(i.Status)));

        ApplyFilter();
        isLoading = false;
    }

    private void ApplyFilter()
    {
        IEnumerable<OrderItem> query = allItems;
        if (!string.IsNullOrWhiteSpace(orderSearch)) query = query.Where(i => i.OrderId.Contains(orderSearch.Trim(), StringComparison.OrdinalIgnoreCase));
        if (orderDate.HasValue) query = query.Where(i => i.Order?.OrderDate.Date == orderDate.Value.Date);
        if (deliveryDate.HasValue) query = query.Where(i => i.Order?.EstimatedDeliveryDate.Date == deliveryDate.Value.Date);
        if (selectedLocation == 1) query = query.Where(i => i.Status == ItemStatus.ReadyAtWorkShop);
        if (selectedLocation == 2) query = query.Where(i => i.Status == ItemStatus.ReadyAtShop);
        if (selectedLocation == 3) query = query.Where(i => i.Status == ItemStatus.Delivered);

        filteredItems = query.ToList();
        filteredGroups = filteredItems
            .GroupBy(i => i.OrderId)
            .OrderByDescending(g => GetRemainingCount(g.Key) == 0)
            .ThenByDescending(g => g.First().Order?.EstimatedDeliveryDate ?? DateTime.MinValue)
            .ThenBy(g => g.Key);
    }

    private int GetRemainingCount(string orderId) => remainingCounts.GetValueOrDefault(orderId);

    private void ResetFilter()
    {
        orderSearch = string.Empty;
        orderDate = null;
        deliveryDate = null;
        selectedLocation = 0;
        ApplyFilter();
    }

    private async Task ConfirmReceiveItem(OrderItem item)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Receive Item at Showroom?",
            Text = $"Move Order #{item.OrderId}, Item #{item.OrderItemId} from the workshop to the showroom?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Receive",
            CancelButtonText = "Cancel"
        });
        if (result.IsConfirmed) await ReceiveItemsAsync(new[] { item });
    }

    private async Task ConfirmReceiveOrder(string orderId)
    {
        var items = allItems.Where(i => i.OrderId == orderId && i.Status == ItemStatus.ReadyAtWorkShop).ToList();
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Receive Workshop Items?",
            Text = $"Receive {items.Count} workshop item(s) for Order #{orderId} at the showroom?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Receive Items",
            CancelButtonText = "Cancel"
        });
        if (result.IsConfirmed) await ReceiveItemsAsync(items);
    }

    private async Task ReceiveItemsAsync(IEnumerable<OrderItem> items)
    {
        foreach (var item in items)
        {
            await WorkflowService.TransitionStatusAsync(item.OrderItemId, ItemStatus.ReadyAtShop, notes: "Item received at showroom.", branchId: item.BranchId, orderId: item.OrderId);
        }
        await LoadDataAsync();
    }

    private async Task ConfirmDeliverItem(OrderItem item)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Deliver Item?",
            Text = $"Mark Order #{item.OrderId}, Item #{item.OrderItemId} as delivered to the customer?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Deliver",
            CancelButtonText = "Cancel",
            ConfirmButtonColor = "#198754"
        });
        if (result.IsConfirmed) await DeliverItemsAsync(new[] { item });
    }

    private async Task ConfirmDeliverOrder(string orderId)
    {
        var items = allItems.Where(i => i.OrderId == orderId && i.Status == ItemStatus.ReadyAtShop).ToList();
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Deliver Whole Order?",
            Text = $"Mark all {items.Count} ready item(s) in Order #{orderId} as delivered?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Deliver Order",
            CancelButtonText = "Cancel",
            ConfirmButtonColor = "#198754"
        });
        if (result.IsConfirmed) await DeliverItemsAsync(items);
    }

    private async Task DeliverItemsAsync(IEnumerable<OrderItem> items)
    {
        foreach (var item in items)
        {
            await WorkflowService.TransitionStatusAsync(item.OrderItemId, ItemStatus.Delivered, notes: "Item delivered to customer.", branchId: item.BranchId, orderId: item.OrderId);
        }
        await LoadDataAsync();
    }
}
