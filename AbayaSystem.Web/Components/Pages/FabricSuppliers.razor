@page "/fabric-suppliers"
@attribute [Authorize(Roles = "Admin,Salesman")]
@using AbayaSystem.Core
@using AbayaSystem.Infrastructure
@using CurrieTechnologies.Razor.SweetAlert2

@inject IFabricManagementService FabricService
@inject SweetAlertService Swal

<div class="container-fluid max-w-1200 py-3">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: #1a1a1a;">🏬 Fabric Suppliers</h3>
            <p class="text-muted small mb-0">Manage fabric shops, vendors, and material suppliers</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="text-muted mt-2">Loading fabric suppliers list...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th style="width: 60px;">#</th>
                                <th>Supplier / Shop Name *</th>
                                <th class="text-center" style="width: 180px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (shops.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        No fabric suppliers found. Use the bottom row to add one.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @for (int i = 0; i < shops.Count; i++)
                                {
                                    var shop = shops[i];
                                    var index = i + 1;

                                    if (editingShopId == shop.FabricShopId)
                                    {
                                        <!-- INLINE EDIT ROW -->
                                        <tr class="table-warning">
                                            <td class="fw-bold">@index</td>
                                            <td>
                                                <input type="text" class="form-control form-control-sm" @bind="editingShop.FabricShopName" placeholder="Shop Name" />
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-success fw-bold" @onclick="UpdateShopAsync">
                                                        <i class="bi bi-check-lg me-1"></i> Update
                                                    </button>
                                                    <button class="btn btn-secondary" @onclick="CancelEdit">
                                                        <i class="bi bi-x-lg me-1"></i> Cancel
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <!-- NORMAL DISPLAY ROW -->
                                        <tr>
                                            <td class="fw-bold">@index</td>
                                            <td class="fw-semibold">@shop.FabricShopName</td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary" @onclick="() => StartEdit(shop)">
                                                        <i class="bi bi-pencil me-1"></i> Edit
                                                    </button>
                                                    <button class="btn btn-outline-danger" @onclick="() => ConfirmDeleteAsync(shop)">
                                                        <i class="bi bi-trash me-1"></i> Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            }

                            <!-- BOTTOM ROW: ADD NEW SHOP -->
                            <tr class="bg-light border-top border-2">
                                <td class="fw-bold text-muted">New</td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" @bind="newShop.FabricShopName" placeholder="Enter Supplier / Shop Name *" />
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-primary fw-bold" @onclick="AddShopAsync" disabled="@isSubmitting">
                                            <i class="bi bi-plus-lg me-1"></i> Add
                                        </button>
                                        <button class="btn btn-outline-secondary" @onclick="ClearNewShopInput">
                                            <i class="bi bi-eraser me-1"></i> Cancel
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<FabricShop> shops = new();
    private FabricShop newShop = new();
    private FabricShop editingShop = new();

    private int? editingShopId = null;
    private bool isLoading = true;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadShopsAsync();
    }

    private async Task LoadShopsAsync()
    {
        try
        {
            isLoading = true;
            shops = await FabricService.GetFabricShopsAsync();
        }
        catch (Exception ex)
        {
            await ShowAutoAlertAsync("Error Loading Data", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    // --- ADD SUPPLIER LOGIC ---
    private async Task AddShopAsync()
    {
        if (string.IsNullOrWhiteSpace(newShop.FabricShopName))
        {
            await ShowAutoAlertAsync("Validation Error", "Supplier name cannot be empty.", SweetAlertIcon.Warning);
            return;
        }

        isSubmitting = true;
        try
        {
            var createdShop = await FabricService.CreateFabricShopAsync(newShop);
            shops.Add(createdShop);
            ClearNewShopInput();
            await ShowAutoAlertAsync("Supplier Added", "New fabric supplier added successfully.", SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            await ShowAutoAlertAsync("Error Adding Supplier", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ClearNewShopInput()
    {
        newShop = new FabricShop();
    }

    // --- INLINE EDIT LOGIC ---
    private void StartEdit(FabricShop shop)
    {
        editingShopId = shop.FabricShopId;
        editingShop = new FabricShop
        {
            FabricShopId = shop.FabricShopId,
            FabricShopName = shop.FabricShopName
        };
    }

    private void CancelEdit()
    {
        editingShopId = null;
        editingShop = new();
    }

    private async Task UpdateShopAsync()
    {
        if (string.IsNullOrWhiteSpace(editingShop.FabricShopName))
        {
            await ShowAutoAlertAsync("Validation Error", "Supplier name cannot be empty.", SweetAlertIcon.Warning);
            return;
        }

        try
        {
            await FabricService.UpdateFabricShopAsync(editingShop);

            var index = shops.FindIndex(s => s.FabricShopId == editingShop.FabricShopId);
            if (index != -1)
            {
                shops[index] = new FabricShop
                {
                    FabricShopId = editingShop.FabricShopId,
                    FabricShopName = editingShop.FabricShopName
                };
            }

            CancelEdit();
            await ShowAutoAlertAsync("Updated", "Supplier details updated successfully.", SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            await ShowAutoAlertAsync("Update Failed", ex.Message, SweetAlertIcon.Error);
        }
    }

    // --- DELETE LOGIC ---
    private async Task ConfirmDeleteAsync(FabricShop shop)
    {
        var confirmResult = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Are you sure?",
            Text = $"Do you want to delete '{shop.FabricShopName}'? This action cannot be undone.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Yes, Delete",
            CancelButtonText = "Cancel",
            ConfirmButtonColor = "#dc3545"
        });

        if (confirmResult.IsConfirmed)
        {
            try
            {
                await FabricService.DeleteFabricShopAsync(shop.FabricShopId);
                shops.RemoveAll(s => s.FabricShopId == shop.FabricShopId);
                await ShowAutoAlertAsync("Deleted", "Fabric supplier removed successfully.", SweetAlertIcon.Success);
            }
            catch (Exception ex)
            {
                await ShowAutoAlertAsync("Delete Failed", ex.Message, SweetAlertIcon.Error);
            }
        }
    }

    // --- HELPER METHODS ---
    private async Task ShowAutoAlertAsync(string title, string message, SweetAlertIcon icon)
    {
        await Swal.FireAsync(new SweetAlertOptions
        {
            Title = title,
            Text = message,
            Icon = icon,
            ShowConfirmButton = false,
            Timer = 1200,
            TimerProgressBar = true
        });
    }
}