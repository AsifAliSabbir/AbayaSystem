@inherits LayoutComponentBase
@using AbayaSystem.Web
@using Microsoft.AspNetCore.Components.Authorization
@inject BoutiqueAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using CurrieTechnologies.Razor.SweetAlert2;

@inject SweetAlertService Swal;

<div class="page-container">

    <!-- 🌫️ Native Bootstrap Styled Backdrop (Closes menu when clicking outside on mobile) -->
    @if (isMobileMenuOpen)
    {
        <div class="offcanvas-backdrop fade show d-lg-none" @onclick="CloseMobileMenu"></div>
    }

    <!-- 🧭 Left Sidebar: Native Bootstrap 5.3.3 Responsive Offcanvas -->
    <aside class="offcanvas-lg offcanvas-start bg-dark text-white shadow border-end border-secondary @(isMobileMenuOpen ? "show" : "")"
           tabindex="-1"
           style="visibility: visible;">

        <!-- Offcanvas Header / Showroom Branding -->
        <div class="offcanvas-header p-4 border-bottom border-secondary justify-content-center position-relative w-100">
            <div class="text-center w-100">
                <h4 class="fw-bold text-uppercase tracking-wider m-0" style="color: #d4af37; font-family: 'Playfair Display', serif;">
                    ✨ ABAYA SYSTEM
                </h4>
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 1.5px;">
                    Showroom Workspace
                </small>
            </div>

            <!-- Native Close Button (Visible only on mobile) -->
            <button type="button" class="btn-close btn-close-white position-absolute end-0 top-50 translate-middle-y me-3 d-lg-none"
                    @onclick="CloseMobileMenu" aria-label="Close"></button>
        </div>

        <!-- Offcanvas Body / Dynamic Context-Driven Navigation -->
        <div class="offcanvas-body d-flex flex-column flex-grow-1 p-0 overflow-y-auto">
            <nav class="flex-grow-1 p-3 d-flex flex-column gap-2">
                <AuthorizeView Roles="Admin,Salesman">
                    <Authorized>
                        <!-- Order Entry Desk -->
                        <a href="/orders/new" class="@GetActiveStyle("/orders/new")" @onclick="CloseMobileMenu">
                            <span class="bi bi-file-earmark-plus-fill me-2"></span>
                            Order Intake
                        </a>

                        <!-- Fabric & Material Inventory -->
                        <a href="/procurement" class="@GetActiveStyle("/procurement")" @onclick="CloseMobileMenu">
                            <span class="bi bi-scissors me-2"></span>
                            Fabric Procurement
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <div class="text-center py-4 text-muted small">
                            Sign in to access workspace tools
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </nav>

            <!-- Bottom User Panel (Only renders if actively signed in) -->
            <div class="p-3 border-top border-secondary bg-black-50 mt-auto">
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex align-items-center gap-2 px-2 text-truncate">
                                <!-- Circular Avatar with First Letter -->
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-dark fw-bold"
                                     style="width: 34px; height: 34px; background-color: #d4af37; min-width: 34px;">
                                    @(context.User.Identity?.Name?[0].ToString().ToUpper() ?? "W")
                                </div>
                                <div class="text-truncate">
                                    <p class="m-0 fw-bold text-white small text-truncate">@context.User.Identity?.Name</p>
                                    <p class="m-0 text-muted" style="font-size: 0.72rem;">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</p>
                                </div>
                            </div>

                            <!-- Safe Logout Action Trigger -->
                            <button class="btn btn-outline-danger btn-sm w-100 py-2 mt-2 d-flex align-items-center justify-content-center gap-2 rounded-3"
                                    @onclick="TriggerLogout">
                                <span class="bi bi-box-arrow-right"></span> Exit Portal
                            </button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-primary w-100 py-2 rounded-3 fw-bold shadow-sm" @onclick="CloseMobileMenu">
                            🔑 Sign In
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </aside>

    <!-- Right Workspace Area -->
    <main class="workspace-panel bg-light d-flex flex-column">

        <!-- Showroom Top Terminal Header -->
        <header class="navbar navbar-light bg-white border-bottom px-3 py-2 shadow-sm d-flex justify-content-between align-items-center flex-shrink-0" style="min-height: 60px;">
            <div class="d-flex align-items-center">
                <!-- ☰ Hamburger Toggle Button: Visible ONLY on mobile/tablet (< lg) -->
                <button type="button" class="btn btn-link text-dark p-0 d-lg-none me-3 border-0 shadow-none text-decoration-none"
                        @onclick="ToggleMobileMenu"
                        style="display: inline-flex; align-items: center; line-height: 1;">
                    <i class="bi bi-list" style="font-size: 2rem; color: #111111 !important;"></i>
                </button>

                <span class="navbar-brand m-0 h5 fw-bold text-dark">
                    Boutique Terminal
                </span>
            </div>

            <span class="text-muted small d-none d-sm-inline font-monospace">
                Dubai Terminal
            </span>
        </header>
        <!-- Page Context Body Wrapper -->
        <div class="container-fluid p-4 flex-grow-1 overflow-auto">
            @Body
        </div>
    </main>
</div>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
        // Swal.FireAsync("Hello world!");
    }

    private string GetActiveStyle(string relativePath)
    {
        var currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        var isActive = currentUrl.Equals(relativePath.TrimStart('/'), StringComparison.OrdinalIgnoreCase);

        return isActive
                    ? "nav-item nav-item-active text-decoration-none d-flex align-items-center p-3 rounded-3"
                    : "nav-item nav-item-inactive text-decoration-none d-flex align-items-center p-3 rounded-3";
    }

    private void TriggerLogout()
    {
        CloseMobileMenu();
        AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login");
    }
}

<!-- Embedded styles for structural overrides -->
<style>
    .page-container {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
        width: 100vw;
        overflow: hidden;
        position: relative;
    }

    /* Standardizes the sidebar width constraints on large screens */
    @@media (min-width: 992px) {
        .offcanvas-lg {
            width: 260px !important;
            min-width: 260px !important;
            max-width: 260px !important;
            height: 100vh !important;
            position: sticky !important;
            top: 0;
        }
    }

    /* Sets custom structural definitions for offcanvas layout drawer targets */
    @@media (max-width: 991.98px) {
        .offcanvas-lg {
            width: 280px !important;
            max-width: 85vw !important;
        }
    }

    .workspace-panel {
        flex-grow: 1;
        height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .bg-black-50 {
        background-color: rgba(0, 0, 0, 0.2);
    }

    .nav-item {
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 0.95rem;
    }

    .nav-item-inactive {
        color: #adb5bd !important;
    }

        .nav-item-inactive:hover {
            background-color: rgba(255, 255, 255, 0.05);
            color: #ffffff !important;
        }

    .nav-item-active {
        background-color: #d4af37 !important;
        color: #000000 !important;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(212, 175, 55, 0.25);
    }

    /* Safety adjustments to force mobile button alignment and icon visibility */
    .d-lg-none i.bi-list {
        display: inline-block !important;
        line-height: 1 !important;
        visibility: visible !important;
    }

    button.d-lg-none {
        min-width: 32px;
        min-height: 32px;
    }
</style>