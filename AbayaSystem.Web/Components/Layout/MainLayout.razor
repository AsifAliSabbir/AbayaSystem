@inherits LayoutComponentBase
@using AbayaSystem.Web
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using CurrieTechnologies.Razor.SweetAlert2

@inject BoutiqueAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject SweetAlertService Swal

<div class="page-container">

    <!-- 🧭 Navigation Menu (Visible ONLY when logged in) -->
    <AuthorizeView>
        <Authorized>
            <!-- 🌫️ Native Mobile Backdrop -->
            @if (isMobileMenuOpen)
            {
                <div class="offcanvas-backdrop fade show d-lg-none" @onclick="CloseMobileMenu"></div>
            }

            <aside class="offcanvas-lg offcanvas-start bg-dark text-white shadow border-end border-secondary @(isMobileMenuOpen ? "show" : "")"
                   tabindex="-1"
                   style="visibility: visible;">

                <!-- Offcanvas Header Branding -->
                <div class="offcanvas-header p-4 border-bottom border-secondary justify-content-center position-relative w-100">
                    <div class="text-center w-100">
                        <h4 class="fw-bold text-uppercase tracking-wider m-0" style="color: #d4af37; font-family: 'Playfair Display', serif;">
                            ABAYA SYSTEM
                        </h4>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 1.5px;">
                            @GetBranchDisplayName(context.User) WORKSPACE
                        </small>
                    </div>

                    <button type="button" class="btn-close btn-close-white position-absolute end-0 top-50 translate-middle-y me-3 d-lg-none"
                            @onclick="CloseMobileMenu" aria-label="Close"></button>
                </div>

                <!-- Offcanvas Body / Accordion Navigation -->
                <div class="offcanvas-body d-flex flex-column flex-grow-1 p-0 overflow-y-auto">
                    <nav class="flex-grow-1 p-3 d-flex flex-column gap-2">

                        <!-- 📦 ORDERS SECTION (Salesman & Admin) -->
                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Salesman"))
                        {
                            <div class="nav-accordion-group">
                                <button type="button"
                                        class="accordion-header-btn w-100 d-flex justify-content-between align-items-center p-2 rounded-3 text-white border-0 bg-transparent"
                                        @onclick='() => ToggleSection("orders")'>
                                    <span class="fw-bold text-uppercase tracking-wider small opacity-75">
                                        <i class="bi bi-box-seam me-2 text-warning"></i> Orders
                                    </span>
                                    <i class="bi @(isOrdersOpen ? "bi-chevron-down" : "bi-chevron-right") small text-muted"></i>
                                </button>

                                @if (isOrdersOpen)
                                {
                                    <div class="nav-children-container ps-3 d-flex flex-column gap-1 mt-1">
                                        <a href="/orders" class="@GetActiveStyle("/orders")" @onclick="CloseMobileMenu">
                                            <i class="bi bi-list-task me-2"></i>
                                            All Orders
                                        </a>
                                    </div>
                                }
                            </div>
                        }

                        <!-- 🔄 WORKFLOW SECTION (Admin, Salesman, Cutting Master, Tailor) -->
                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Salesman") || context.User.IsInRole("CuttingMaster") || context.User.IsInRole("Cutting Master") || context.User.IsInRole("Tailor") || context.User.IsInRole("HandEmbroiderer"))
                        {
                            <div class="nav-accordion-group">
                                <button type="button"
                                        class="accordion-header-btn w-100 d-flex justify-content-between align-items-center p-2 rounded-3 text-white border-0 bg-transparent"
                                        @onclick='() => ToggleSection("workflow")'>
                                    <span class="fw-bold text-uppercase tracking-wider small opacity-75">
                                        <i class="bi bi-diagram-3 me-2 text-warning"></i> Workflow
                                    </span>
                                    <i class="bi @(isWorkflowOpen ? "bi-chevron-down" : "bi-chevron-right") small text-muted"></i>
                                </button>

                                @if (isWorkflowOpen)
                                {
                                    <div class="nav-children-container ps-3 d-flex flex-column gap-1 mt-1">
                                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Salesman"))
                                        {
                                            <a href="/orders/new" class="@GetActiveStyle("/orders/new")" @onclick="CloseMobileMenu">
                                                <i class="bi bi-file-earmark-plus-fill me-2"></i>
                                                Order Intake
                                            </a>
                                            <a href="/fabric-procurement" class="@GetActiveStyle("/fabric-procurement")" @onclick="CloseMobileMenu">
                                                <i class="bi bi-cart-check me-2"></i>
                                                Fabric Procurement
                                            </a>
                                            <a href="/external-dispatch" class="@GetActiveStyle("/external-dispatch")" @onclick="CloseMobileMenu">
                                                <i class="bi bi-truck me-2"></i>
                                                External Dispatch
                                            </a>
                                            <a href="/external-vendor-tracking" class="@GetActiveStyle("/external-vendor-tracking")" @onclick="CloseMobileMenu">
                                                <i class="bi bi-binoculars me-2"></i>
                                                External Vendor Tracking
                                            </a>
                                            <a href="/external-vendor-returns" class="@GetActiveStyle("/external-vendor-returns")" @onclick="CloseMobileMenu">
                                                <i class="bi bi-box-arrow-in-left me-2"></i>
                                                External Vendor Returns
                                            </a>
                                            <a href="/ready-items" class="@GetActiveStyle("/ready-items")" @onclick="CloseMobileMenu">
                                                <i class="bi bi-box-seam me-2"></i>
                                                Ready Items
                                            </a>
                                        }

                                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Salesman") || context.User.IsInRole("CuttingMaster") || context.User.IsInRole("Cutting Master"))
                                        {
                                            <a href="/hand-embroidery-assignment" class="@GetActiveStyle("/hand-embroidery-assignment")" @onclick="CloseMobileMenu">
                                                <i class="bi bi-person-check me-2"></i>
                                                Hand Embroidery Assignment
                                            </a>

                                            <a href="/tailor-assignment" class="@GetActiveStyle("/tailor-assignment")" @onclick="CloseMobileMenu">
                                                <i class="bi bi-person-workspace me-2"></i>
                                                Tailor Assignment
                                            </a>
                                        }

                                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Salesman") || context.User.IsInRole("CuttingMaster") || context.User.IsInRole("Cutting Master"))
                                        {
                                            <a href="/cutting-dashboard" class="@GetActiveStyle("/cutting-dashboard")" @onclick="CloseMobileMenu">
                                                <i class="bi bi-scissors me-2"></i>
                                                Cutting Dashboard
                                            </a>
                                        }

                                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Salesman") || context.User.IsInRole("CuttingMaster") || context.User.IsInRole("Cutting Master") || context.User.IsInRole("Tailor"))
                                        {
                                            <a href="/tailor-dashboard" class="@GetActiveStyle("/tailor-dashboard")" @onclick="CloseMobileMenu">
                                                <i class="bi bi-scissors me-2"></i>
                                                Tailors Dashboard
                                            </a>
                                        }

                                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Salesman") || context.User.IsInRole("CuttingMaster") || context.User.IsInRole("Cutting Master") || context.User.IsInRole("HandEmbroiderer"))
                                        {
                                            <a href="/hand-embroiderer-dashboard" class="@GetActiveStyle("/hand-embroiderer-dashboard")" @onclick="CloseMobileMenu">
                                                <i class="bi bi-brush me-2"></i>
                                                Hand Embroiderer Dashboard
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <!-- 👥 WORKERS SECTION (Admin Only) -->
                        @if (context.User.IsInRole("Admin"))
                        {
                            <div class="nav-accordion-group">
                                <button type="button"
                                        class="accordion-header-btn w-100 d-flex justify-content-between align-items-center p-2 rounded-3 text-white border-0 bg-transparent"
                                        @onclick='() => ToggleSection("workers")'>
                                    <span class="fw-bold text-uppercase tracking-wider small opacity-75">
                                        <i class="bi bi-people me-2 text-warning"></i> Workers
                                    </span>
                                    <i class="bi @(isWorkersOpen ? "bi-chevron-down" : "bi-chevron-right") small text-muted"></i>
                                </button>

                                @if (isWorkersOpen)
                                {
                                    <div class="nav-children-container ps-3 d-flex flex-column gap-1 mt-1">
                                        <a href="/workers" class="@GetActiveStyle("/workers")" @onclick="CloseMobileMenu">
                                            <i class="bi bi-scissors me-2"></i>
                                            Internal Worker Entry
                                        </a>
                                        <a href="/external-workers" class="@GetActiveStyle("/external-workers")" @onclick="CloseMobileMenu">
                                            <i class="bi bi-shop me-2"></i>
                                            External Worker Entry
                                        </a>
                                    </div>
                                }
                            </div>
                        }

                        <!-- 🧵 FABRICS SECTION (Salesman & Admin) -->
                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Salesman"))
                        {
                            <div class="nav-accordion-group">
                                <button type="button"
                                        class="accordion-header-btn w-100 d-flex justify-content-between align-items-center p-2 rounded-3 text-white border-0 bg-transparent"
                                        @onclick='() => ToggleSection("fabrics")'>
                                    <span class="fw-bold text-uppercase tracking-wider small opacity-75">
                                        <i class="bi bi-layers me-2 text-warning"></i> Fabrics
                                    </span>
                                    <i class="bi @(isFabricsOpen ? "bi-chevron-down" : "bi-chevron-right") small text-muted"></i>
                                </button>

                                @if (isFabricsOpen)
                                {
                                    <div class="nav-children-container ps-3 d-flex flex-column gap-1 mt-1">
                                        <a href="/fabric-suppliers" class="@GetActiveStyle("/fabric-suppliers")" @onclick="CloseMobileMenu">
                                            <i class="bi bi-building me-2"></i>
                                            Fabric Supplier Entry
                                        </a>
                                        <a href="/fabric-types" class="@GetActiveStyle("/fabric-types")" @onclick="CloseMobileMenu">
                                            <i class="bi bi-palette me-2"></i>
                                            Fabric Types Entry
                                        </a>
                                    </div>
                                }
                            </div>
                        }

                    </nav>
                </div>
            </aside>
        </Authorized>
    </AuthorizeView>

    <!-- Right Workspace Area -->
    <main class="workspace-panel bg-light d-flex flex-column">

        <!-- Top Header Panel -->
        <header class="navbar navbar-light bg-white border-bottom px-3 py-2 shadow-sm d-flex justify-content-between align-items-center flex-shrink-0" style="min-height: 60px;">
            <div class="d-flex align-items-center">
                <AuthorizeView>
                    <Authorized>
                        <!-- Hamburger Toggle Button -->
                        <button type="button" class="btn btn-link text-dark p-0 d-lg-none me-3 border-0 shadow-none text-decoration-none"
                                @onclick="ToggleMobileMenu"
                                style="display: inline-flex; align-items: center; line-height: 1;">
                            <i class="bi bi-list" style="font-size: 2rem; color: #111111 !important;"></i>
                        </button>

                        <!-- Dynamic Logged-In User Branch Name -->
                        <span class="navbar-brand m-0 h5 fw-bold text-dark text-uppercase">
                            @GetBranchDisplayName(context.User)
                        </span>
                    </Authorized>
                    <NotAuthorized>
                        <span class="navbar-brand m-0 h5 fw-bold text-dark text-uppercase">
                            ABAYA SYSTEM
                        </span>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <!-- Worker Profile Button & Exit Portal Popup Menu -->
            <AuthorizeView>
                <Authorized>
                    <div class="position-relative">
                        <button type="button"
                                class="btn btn-outline-dark btn-sm rounded-pill px-3 py-1 fw-bold d-flex align-items-center gap-2 shadow-sm"
                                @onclick="ToggleUserMenu">
                            <i class="bi bi-person-circle text-warning fs-6"></i>
                            <span class="fw-bold">@(context.User.Identity?.Name ?? "Worker")</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>

                        <!-- Exit Portal Dropdown Popup -->
                        @if (isUserMenuOpen)
                        {
                            <div class="dropdown-menu dropdown-menu-end show shadow-lg border-0 rounded-3 mt-2 p-2 position-absolute end-0"
                                 style="z-index: 1050; min-width: 210px; background-color: #ffffff;">
                                <div class="px-3 py-2 border-bottom mb-2 bg-light rounded-2">
                                    <p class="m-0 fw-bold text-dark small text-truncate">@context.User.Identity?.Name</p>
                                    <p class="m-0 text-muted extra-small">@context.User.FindFirst(ClaimTypes.Role)?.Value</p>
                                </div>
                                <button class="dropdown-item text-danger fw-bold rounded-2 d-flex align-items-center gap-2 py-2"
                                        @onclick="TriggerLogout">
                                    <i class="bi bi-box-arrow-right"></i> Exit Portal
                                </button>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn btn-primary btn-sm rounded-pill px-3 py-1 fw-bold shadow-sm">
                        🔑 Sign In
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <!-- Main Page Content Body -->
        <div class="container-fluid p-4 flex-grow-1 overflow-auto">
            @Body
        </div>
    </main>
</div>

@code {
    private bool isMobileMenuOpen = false;
    private bool isUserMenuOpen = false;

    // Accordion Expansion States
    private bool isOrdersOpen = true;
    private bool isWorkflowOpen = true;
    private bool isWorkersOpen = false;
    private bool isFabricsOpen = false;

    protected override void OnInitialized()
    {
        AutoExpandActiveSection();
    }

    private void ToggleSection(string sectionName)
    {
        switch (sectionName.ToLower())
        {
            case "orders":
                isOrdersOpen = !isOrdersOpen;
                break;
            case "workflow":
                isWorkflowOpen = !isWorkflowOpen;
                break;
            case "workers":
                isWorkersOpen = !isWorkersOpen;
                break;
            case "fabrics":
                isFabricsOpen = !isFabricsOpen;
                break;
        }
    }

    private void AutoExpandActiveSection()
    {
        var currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();

        if (currentUrl.Equals("orders/new") || currentUrl.StartsWith("fabric-procurement") || currentUrl.StartsWith("cutting-dashboard") || currentUrl.StartsWith("tailor-dashboard") || currentUrl.StartsWith("hand-embroiderer-dashboard") || currentUrl.StartsWith("external-dispatch") || currentUrl.StartsWith("external-vendor-tracking") || currentUrl.StartsWith("external-vendor-returns") || currentUrl.StartsWith("hand-embroidery-assignment") || currentUrl.StartsWith("tailor-assignment") || currentUrl.StartsWith("ready-items"))
        {
            isWorkflowOpen = true;
        }
        else if (currentUrl.StartsWith("orders"))
        {
            isOrdersOpen = true;
        }
        else if (currentUrl.StartsWith("workers") || currentUrl.StartsWith("external-workers"))
        {
            isWorkersOpen = true;
        }
        else if (currentUrl.StartsWith("fabric-suppliers") || currentUrl.StartsWith("fabric-types"))
        {
            isFabricsOpen = true;
        }
    }

    private string GetBranchDisplayName(ClaimsPrincipal user)
    {
        if (user.IsInRole("Admin"))
        {
            return "ADMIN";
        }

        var branchClaim = user.FindFirst("BranchName")?.Value;

        if (!string.IsNullOrWhiteSpace(branchClaim))
        {
            return branchClaim.ToUpper();
        }

        return "BRANCH";
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
        isUserMenuOpen = false;
    }

    private void ToggleUserMenu()
    {
        isUserMenuOpen = !isUserMenuOpen;
    }

    private string GetActiveStyle(string relativePath)
    {
        var currentUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        var isActive = currentUrl.Equals(relativePath.TrimStart('/'), StringComparison.OrdinalIgnoreCase);

        return isActive
            ? "nav-item nav-item-active text-decoration-none d-flex align-items-center p-2 rounded-3"
            : "nav-item nav-item-inactive text-decoration-none d-flex align-items-center p-2 rounded-3";
    }

    private void TriggerLogout()
    {
        isUserMenuOpen = false;
        CloseMobileMenu();
        AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login");
    }
}

<style>
    .page-container {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
        width: 100vw;
        overflow: hidden;
        position: relative;
    }

    @@media (min-width: 992px) {
        .offcanvas-lg {
            width: 260px !important;
            min-width: 260px !important;
            max-width: 260px !important;
            height: 100vh !important;
            position: sticky !important;
            top: 0;
        }
    }

    @@media (max-width: 991.98px) {
        .offcanvas-lg {
            width: 280px !important;
            max-width: 85vw !important;
        }
    }

    .workspace-panel {
        flex-grow: 1;
        height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .bg-black-50 {
        background-color: rgba(0, 0, 0, 0.2);
    }

    .accordion-header-btn {
        transition: background-color 0.2s ease-in-out;
    }

        .accordion-header-btn:hover {
            background-color: rgba(255, 255, 255, 0.08) !important;
        }

    .nav-item {
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 0.9rem;
    }

    .nav-item-inactive {
        color: #adb5bd !important;
    }

        .nav-item-inactive:hover {
            background-color: rgba(255, 255, 255, 0.05);
            color: #ffffff !important;
        }

    .nav-item-active {
        background-color: #d4af37 !important;
        color: #000000 !important;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(212, 175, 55, 0.25);
    }

    .extra-small {
        font-size: 0.72rem;
    }
</style>