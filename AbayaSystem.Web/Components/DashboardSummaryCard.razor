@using Microsoft.AspNetCore.Components

<div class="col-sm-6 col-xl-3">
    <div class="card border-0 shadow-sm rounded-3 h-100">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div>
                <div class="text-muted small fw-semibold text-uppercase">@Title</div>
                <div class="fs-3 fw-bold text-dark mt-1">@Value</div>
            </div>
            <div class="dashboard-icon bg-@Color-subtle text-@Color">
                <i class="bi @Icon fs-4"></i>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public string Color { get; set; } = "primary";
}

<style>
    .dashboard-icon {
        width: 48px;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
    }
</style>
